# ROM files - they never enter the repository and never ship in a release.
# This repository distributes TOOLS only. The ROM is yours, and the build
# made from it is a derivative work: it leaves your machine, never here.
*.gbc
*.gbc.*
*.gb
*.gb.*
*.sav
*.rtc
rom/
roms/
build/
.tools/
# Runtime que veio junto com as ferramentas de um release
runtime/

# Project generated by gbrecomp (code derived from the ROM)
output/
baserom*.c
baserom*.h
baserom*.json
gbrecomp-contract.json

# Logs and test artifacts
*.log
.bootstrap.log
.build.log
*.ppm
# Screenshots stay out, but the interface icon is ours and is versioned.
*.png
!tools/gui/icon.png
captures/

# Tools built here
*.o
*.a
gbrecomp

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Artefato montado pelo packaging/make_release.sh
packaging/dist/

# O jogo (Dear ImGui) escreve isto na pasta de onde foi aberto
imgui.ini
