+    const int lattice = (dst_w > 0) ? (dst_w / GB_SCREEN_WIDTH) : 1;
+    const int steps = (lattice > 0) ? lattice : 1;
+    /* Half a mask pixel: the standard analytic coverage ramp. Anything steeper
+     * stops resolving the gap and snaps it to whole samples. */
+    float soft = 0.5f / (float)steps;
+    /* The grid draws half a gap on each side, so its border has to stay wider
+     * than the ramp or the plateau between the two shoulders disappears. */
+    const float border = gap * 0.5f;
+    if (soft > border * 0.9f) {
+        soft = border * 0.9f;
+    }
