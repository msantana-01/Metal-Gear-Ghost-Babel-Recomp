+/* One step of the panel relaxing toward `target`, in place.
+ *
+ * Exponential rather than linear, with the coefficient derived from the elapsed
+ * wall time rather than from a per-frame constant. That is what keeps the trail
+ * the same length at 30 fps, 60 and 144: a fixed per-frame alpha halves the
+ * trail at double the rate and disappears entirely on a fast display.
+ *
+ * The coefficient is "how much of the new target has arrived": 1 reproduces the
+ * target exactly, 0 freezes the panel on what it was already showing. The
+ * feature being off costs nothing because the caller skips the call entirely,
+ * not because of any value of alpha.
+ */
+static void apply_lcd_response(const uint32_t* prev, uint32_t* dst, int pitch_bytes,
+                               int width, int height, float dark_alpha,
+                               float light_alpha) {
+    for (int y = 0; y < height; ++y) {
+        uint32_t* row = (uint32_t*)((uint8_t*)dst + (size_t)y * (size_t)pitch_bytes);
+        const uint32_t* prev_row = prev + (size_t)y * (size_t)width;
+        for (int x = 0; x < width; ++x) {
+            const uint32_t previous = prev_row[x];
+            const uint32_t target = row[x];
+            uint32_t out = target & 0xFF000000u;
+            for (int shift = 16; shift >= 0; shift -= 8) {
+                const uint32_t from = (previous >> shift) & 0xFFu;
+                const uint32_t to = (target >> shift) & 0xFFu;
+                /* Falling luminance is the fast direction on the real panel. */
+                const float alpha = (to < from) ? dark_alpha : light_alpha;
+                float value = (float)from + ((float)to - (float)from) * alpha;
+                /* Snap once the remainder is under a level. Without this a
+                 * one-level difference never closes - the step is smaller than
+                 * the rounding - and the panel settles a shade below the guest
+                 * colour for good, which is a permanent brightness bias nobody
+                 * would notice and everybody would inherit. */
+                if (fabsf((float)to - value) < 1.0f) {
+                    value = (float)to;
+                }
+                out |= ((uint32_t)lrintf(clampf(value, 0.0f, 255.0f)) & 0xFFu) << shift;
+            }
+            row[x] = out;
+        }
+    }
+}
+
+/* alpha for a given elapsed time and response time constant: the exact
+ * solution of du/dt = (u_target - u)/tau, sampled at dt. */
+static float lcd_response_alpha(float dt_ms, float tau_ms) {
+    if (tau_ms <= 0.0f) {
+        return 1.0f;
+    }
+    return 1.0f - expf(-(dt_ms / tau_ms));
+}
