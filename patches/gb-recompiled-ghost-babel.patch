 1 file changed, 4 insertions(+)

diff --git a/runtime/src/platform_sdl.cpp b/runtime/src/platform_sdl.cpp
index 22f4081..dcbfa38 100644
--- a/runtime/src/platform_sdl.cpp
+++ b/runtime/src/platform_sdl.cpp
@@ -2688,6 +2688,10 @@ ImGui::PushItemWidth(ImGui::GetContentRegionAvail().x * 0.55f);
         const float footer_button_width =
             (content_w - ImGui::GetStyle().ItemSpacing.x * (footer_button_count - 1)) /
             (float)footer_button_count;
+        /* Immediately before the button, not before the Separator above it:
+         * SetCursorPosX only holds for the next item, so positioning the rule
