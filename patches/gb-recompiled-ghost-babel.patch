+        const uint32_t* prev_row = prev + (size_t)y * (size_t)width;
+        for (int x = 0; x < width; ++x) {
+            const uint32_t previous = prev_row[x];
+            const uint32_t target = row[x];
+            uint32_t out = target & 0xFF000000u;
+            for (int shift = 16; shift >= 0; shift -= 8) {
+                const uint32_t from = (previous >> shift) & 0xFFu;
+                const uint32_t to = (target >> shift) & 0xFFu;
+                /* Falling luminance is the fast direction on the real panel. */
+                const float alpha = (to < from) ? dark_alpha : light_alpha;
+                float value = (float)from + ((float)to - (float)from) * alpha;
+                /* Snap once the remainder is under a level. Without this a
+                 * one-level difference never closes - the step is smaller than
+                 * the rounding - and the panel settles a shade below the guest
+                 * colour for good, which is a permanent brightness bias nobody
+                 * would notice and everybody would inherit. */
+                if (fabsf((float)to - value) < 1.0f) {
+                    value = (float)to;
+                }
+                out |= ((uint32_t)lrintf(clampf(value, 0.0f, 255.0f)) & 0xFFu) << shift;
+            }
+            row[x] = out;
+        }
+    }
+}
