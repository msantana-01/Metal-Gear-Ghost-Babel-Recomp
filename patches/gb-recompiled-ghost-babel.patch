-/* Renders one guest frame through the CRT GLSL shader. The SDL_Renderer is
- * not used for the guest image when the shader effect is active. */
-static void opengl_render_frame(const uint32_t* framebuffer, int width, int height,
-                                float intensity) {
-    if (!g_gl_initialized || !g_shader_program) {
-        return;
-    }
-
-    if (!SDL_GL_MakeCurrent(g_window, g_gl_context)) {
-        return;
-    }
-
-    glViewport_fn(0, 0, width, height);
-    glClear_fn(GL_COLOR_BUFFER_BIT);
-
-    glUseProgram_fn(g_shader_program);
-
-    /* Query uniform locations lazily (only valid after program is bound). */
-    if (g_shader_loc_texture < 0) {
-        g_shader_loc_texture = glGetUniformLocation_fn(g_shader_program, "u_texture");
-        g_shader_loc_intensity = glGetUniformLocation_fn(g_shader_program, "u_intensity");
-        g_shader_loc_time = glGetUniformLocation_fn(g_shader_program, "u_time");
-        g_shader_loc_resolution = glGetUniformLocation_fn(g_shader_program, "u_resolution");
-    }
-
-    glActiveTexture_fn(GL_TEXTURE0);
-    glBindTexture_fn(GL_TEXTURE_2D, g_shader_texture);
-    glTexImage2D_fn(GL_TEXTURE_2D, 0, GL_RGBA, width, height, 0, GL_RGBA,
-                    GL_UNSIGNED_BYTE, framebuffer);
-    glUniform1i_fn(g_shader_loc_texture, 0);
-    glUniform1f_fn(g_shader_loc_intensity, intensity);
-    float elapsed = (float)(SDL_GetTicks() - g_shader_start_ticks) / 1000.0f;
-    glUniform1f_fn(g_shader_loc_time, elapsed);
-    glUniform2f_fn(g_shader_loc_resolution, (float)width, (float)height);
