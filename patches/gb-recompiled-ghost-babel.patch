+static void destroy_savestate_thumb_texture(void) {
+    if (g_savestate_thumb_texture) {
+        SDL_DestroyTexture(g_savestate_thumb_texture);
+        g_savestate_thumb_texture = NULL;
+    }
+    g_savestate_thumb_slot = -1;
+    g_savestate_thumb_w = 0;
+    g_savestate_thumb_h = 0;
+    g_savestate_thumb_has_image = false;
+    g_savestate_thumb_dirty = true;
+    g_savestate_thumb_path.clear();
+}
+
+static bool write_savestate_thumbnail(const char* state_path,
+                                      const uint32_t* argb,
+                                      int width,
+                                      int height) {
+    if (!state_path || !state_path[0] || !argb ||
+        width < 1 || width > GB_PRESENT_MAX_WIDTH ||
+        height < 1 || height > GB_SCREEN_HEIGHT) {
+        return false;
+    }
+    const std::string thumb_path = std::string(state_path) + ".thumb";
+    const std::string tmp_path = thumb_path + ".tmp";
+    const size_t pixel_count = (size_t)width * (size_t)height;
+    std::vector<uint8_t> buf(12u + pixel_count * 2u);
+    buf[0] = (uint8_t)(GB_SAVESTATE_THUMB_MAGIC & 0xFFu);
+    buf[1] = (uint8_t)((GB_SAVESTATE_THUMB_MAGIC >> 8) & 0xFFu);
+    buf[2] = (uint8_t)((GB_SAVESTATE_THUMB_MAGIC >> 16) & 0xFFu);
+    buf[3] = (uint8_t)((GB_SAVESTATE_THUMB_MAGIC >> 24) & 0xFFu);
+    buf[4] = (uint8_t)(width & 0xFF);
+    buf[5] = (uint8_t)((width >> 8) & 0xFF);
+    buf[6] = (uint8_t)(height & 0xFF);
+    buf[7] = (uint8_t)((height >> 8) & 0xFF);
+    buf[8] = (uint8_t)(GB_SAVESTATE_THUMB_FORMAT_RGB565 & 0xFFu);
+    buf[9] = 0u;
+    buf[10] = 0u;
+    buf[11] = 0u;
+    for (size_t i = 0; i < pixel_count; ++i) {
+        const uint32_t px = argb[i];
+        const uint16_t r = (uint16_t)((px >> 16) & 0xFFu);
+        const uint16_t g = (uint16_t)((px >> 8) & 0xFFu);
+        const uint16_t b = (uint16_t)(px & 0xFFu);
+        const uint16_t rgb565 = (uint16_t)(((r & 0xF8u) << 8) | ((g & 0xFCu) << 3) | (b >> 3));
+        buf[12u + i * 2u] = (uint8_t)(rgb565 & 0xFFu);
+        buf[12u + i * 2u + 1u] = (uint8_t)((rgb565 >> 8) & 0xFFu);
+    }
+    FILE* file = fopen(tmp_path.c_str(), "wb");
+    if (!file) {
+        return false;
+    }
+    const size_t written = fwrite(buf.data(), 1u, buf.size(), file);
+    if (fclose(file) != 0 || written != buf.size()) {
+        std::error_code rm_ec;
+        fs::remove(fs::path(tmp_path), rm_ec);
+        return false;
+    }
+    std::error_code ec;
+    fs::rename(fs::path(tmp_path), fs::path(thumb_path), ec);
+    if (ec) {
+        fs::remove(fs::path(thumb_path), ec);
+        ec.clear();
+        fs::rename(fs::path(tmp_path), fs::path(thumb_path), ec);
+        if (ec) {
+            std::error_code rm_ec;
+            fs::remove(fs::path(tmp_path), rm_ec);
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool read_savestate_thumbnail(const char* state_path,
+                                     std::vector<uint16_t>* out_pixels,
+                                     int* out_w,
+                                     int* out_h) {
+    if (!state_path || !state_path[0] || !out_pixels || !out_w || !out_h) {
+        return false;
+    }
+    out_pixels->clear();
+    *out_w = 0;
+    *out_h = 0;
+    const std::string thumb_path = std::string(state_path) + ".thumb";
+    FILE* file = fopen(thumb_path.c_str(), "rb");
+    if (!file) {
+        return false;
+    }
+    if (fseek(file, 0L, SEEK_END) != 0) {
+        fclose(file);
+        return false;
+    }
+    const long size = ftell(file);
+    if (size < 12L || fseek(file, 0L, SEEK_SET) != 0) {
+        fclose(file);
+        return false;
+    }
+    std::vector<uint8_t> raw((size_t)size);
+    if (fread(raw.data(), 1u, raw.size(), file) != raw.size()) {
+        fclose(file);
+        return false;
+    }
+    fclose(file);
+
+    const uint32_t magic = (uint32_t)raw[0] | ((uint32_t)raw[1] << 8) |
+                           ((uint32_t)raw[2] << 16) | ((uint32_t)raw[3] << 24);
+    const int width = (int)((uint16_t)raw[4] | ((uint16_t)raw[5] << 8));
+    const int height = (int)((uint16_t)raw[6] | ((uint16_t)raw[7] << 8));
+    const uint16_t format = (uint16_t)(raw[8] | ((uint16_t)raw[9] << 8));
+    const uint16_t reserved = (uint16_t)(raw[10] | ((uint16_t)raw[11] << 8));
+    if (magic != GB_SAVESTATE_THUMB_MAGIC ||
+        format != GB_SAVESTATE_THUMB_FORMAT_RGB565 ||
+        reserved != 0u ||
+        width < 1 || width > GB_PRESENT_MAX_WIDTH ||
+        height < 1 || height > GB_SCREEN_HEIGHT) {
+        return false;
+    }
+    const size_t pixel_count = (size_t)width * (size_t)height;
+    if (raw.size() != 12u + pixel_count * 2u) {
+        return false;
+    }
+    out_pixels->resize(pixel_count);
+    for (size_t i = 0; i < pixel_count; ++i) {
+        (*out_pixels)[i] =
+            (uint16_t)(raw[12u + i * 2u] | ((uint16_t)raw[12u + i * 2u + 1u] << 8));
+    }
+    *out_w = width;
+    *out_h = height;
+    return true;
+}
+
+static bool format_file_timestamp(const char* path, char* out, size_t out_size) {
+    if (!path || !path[0] || !out || out_size == 0) {
+        return false;
+    }
+    out[0] = '\0';
+    std::error_code ec;
+    const auto ftime = fs::last_write_time(fs::path(path), ec);
+    if (ec) {
+        return false;
+    }
+    const auto now_file = fs::file_time_type::clock::now();
+    const auto now_sys = std::chrono::system_clock::now();
+    const auto sctp = std::chrono::time_point_cast<std::chrono::system_clock::duration>(
+        ftime - now_file + now_sys);
+    const std::time_t tt = std::chrono::system_clock::to_time_t(sctp);
+    std::tm tm_local = {};
+#if defined(_WIN32)
+    if (localtime_s(&tm_local, &tt) != 0) {
+        return false;
+    }
+#else
+    if (!localtime_r(&tt, &tm_local)) {
+        return false;
+    }
+#endif
+    return std::strftime(out, out_size, "%Y-%m-%d %H:%M:%S", &tm_local) > 0;
+}
+
+static void refresh_savestate_thumb_preview(const std::string& state_path, int slot) {
+    if (!g_savestate_thumb_dirty &&
+        g_savestate_thumb_slot == slot &&
+        g_savestate_thumb_path == state_path) {
+        return;
+    }
+    g_savestate_thumb_dirty = false;
+    g_savestate_thumb_slot = slot;
+    g_savestate_thumb_path = state_path;
+    g_savestate_thumb_has_image = false;
+
+    if (!g_renderer || state_path.empty()) {
+        return;
+    }
+    std::vector<uint16_t> pixels;
+    int w = 0;
+    int h = 0;
+    if (!read_savestate_thumbnail(state_path.c_str(), &pixels, &w, &h)) {
+        return;
+    }
+    if (!g_savestate_thumb_texture ||
+        g_savestate_thumb_w != w ||
+        g_savestate_thumb_h != h) {
+        if (g_savestate_thumb_texture) {
+            SDL_DestroyTexture(g_savestate_thumb_texture);
+            g_savestate_thumb_texture = NULL;
+        }
+        g_savestate_thumb_texture = SDL_CreateTexture(
+            g_renderer, SDL_PIXELFORMAT_RGB565, SDL_TEXTUREACCESS_STATIC, w, h);
+        if (!g_savestate_thumb_texture) {
+            return;
+        }
+#if SDL_VERSION_ATLEAST(2, 0, 12)
+        SDL_SetTextureScaleMode(g_savestate_thumb_texture, SDL_ScaleModeLinear);
+#endif
+        g_savestate_thumb_w = w;
+        g_savestate_thumb_h = h;
+    }
+    if (SDL_UpdateTexture(g_savestate_thumb_texture,
+                          NULL,
+                          pixels.data(),
+                          w * (int)sizeof(uint16_t)) == 0) {
+        g_savestate_thumb_has_image = true;
+    }
+}
