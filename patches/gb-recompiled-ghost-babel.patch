+/* Dynamic Rate Control helpers for lock-step V-Sync without audio drift. */
+static float compute_drc_ratio(uint32_t available, uint32_t target_fill, float max_skew) {
+    if (target_fill == 0 || max_skew <= 0.0f) {
+        return 1.0f;
+    }
+    const float error = ((float)available - (float)target_fill) / (float)target_fill;
+    float skew = error * max_skew;
+    if (skew > max_skew) skew = max_skew;
+    if (skew < -max_skew) skew = -max_skew;
+    return 1.0f + skew;
+}
+
+static uint32_t resample_stereo_block(const int16_t* ring,
+                                      uint32_t ring_size,
+                                      uint32_t read_pos,
+                                      uint32_t available,
+                                      double ratio,
+                                      double* phase,
+                                      int16_t* out,
+                                      uint32_t out_frames,
+                                      float volume_scale,
+                                      uint32_t* out_consumed) {
+    if (out_consumed) {
+        *out_consumed = 0;
+    }
+    if (!ring || ring_size == 0 || available == 0 || !phase || !out || out_frames == 0 ||
+        ratio <= 0.0) {
+        return 0;
+    }
+    double pos = *phase;
+    if (pos < 0.0) {
+        pos = 0.0;
+    }
+    uint32_t produced = 0;
+    while (produced < out_frames) {
+        const uint32_t idx0 = (uint32_t)pos;
+        if (idx0 >= available) {
+            break;
+        }
+        const uint32_t idx1 = (idx0 + 1u < available) ? (idx0 + 1u) : idx0;
+        const float frac = (float)(pos - (double)idx0);
+        const uint32_t r0 = (read_pos + idx0) % ring_size;
+        const uint32_t r1 = (read_pos + idx1) % ring_size;
+        const float l0 = (float)ring[r0 * 2u];
+        const float r_0 = (float)ring[r0 * 2u + 1u];
+        const float l1 = (float)ring[r1 * 2u];
+        const float r_1 = (float)ring[r1 * 2u + 1u];
+        const float l_interp = (l0 + (l1 - l0) * frac) * volume_scale;
+        const float r_interp = (r_0 + (r_1 - r_0) * frac) * volume_scale;
+        long li = lrintf(l_interp);
+        long ri = lrintf(r_interp);
+        if (li < -32768) li = -32768;
+        if (li > 32767) li = 32767;
+        if (ri < -32768) ri = -32768;
+        if (ri > 32767) ri = 32767;
+        out[produced * 2u] = (int16_t)li;
+        out[produced * 2u + 1u] = (int16_t)ri;
+        produced++;
+        pos += ratio;
+    }
+    uint32_t consumed = (uint32_t)pos;
+    if (consumed >= available) {
+        consumed = available;
+        *phase = 0.0;
+    } else {
+        *phase = pos - (double)consumed;
+    }
+    if (out_consumed) {
+        *out_consumed = consumed;
+    }
+    return produced;
+}
