--- /dev/null
+++ b/tests/test_lcd_response.cpp
@@ -0,0 +1,134 @@
+#include "gbrt.h"
+#include "platform_sdl.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdint>
+
+/* The panel response model. What matters here is not that it looks like a trail
+ * but that the trail is the same length regardless of frame rate, and that it
+ * falls faster than it rises - the two properties that a fixed per-frame
+ * coefficient gets wrong. */
+
+static uint32_t argb(uint32_t r, uint32_t g, uint32_t b) {
+    return 0xFF000000u | (r << 16) | (g << 8) | b;
+}
+static uint32_t red_of(uint32_t v) { return (v >> 16) & 0xFFu; }
+
+/* The runtime relaxes the locked texture in place, but the guest frame is
+ * rewritten into it before every step, so the target is always fresh. The
+ * harness has to keep them apart or the "target" decays into the history. */
+static uint32_t step(uint32_t previous, uint32_t target, float dark, float light) {
+    gb_platform_test_apply_lcd_response(&previous, &target, (int)sizeof(uint32_t), 1, 1,
+                                        dark, light);
+    return target;
+}
+
+static int fail(const char* what) {
+    std::fprintf(stderr, "FAIL: %s\n", what);
+    return 1;
+}
+
+int main() {
+    const float tau = 45.0f;
+    const uint32_t white = argb(255, 255, 255);
+    const uint32_t black = argb(0, 0, 0);
+
+    /* 1. The coefficient function. */
+    if (gb_platform_test_lcd_response_alpha(0.0f, tau) != 0.0f) {
+        return fail("no elapsed time must mean no relaxation");
+    }
+    if (gb_platform_test_lcd_response_alpha(16.0f, tau) <=
+        gb_platform_test_lcd_response_alpha(8.0f, tau)) {
+        return fail("alpha must grow with elapsed time");
+    }
+    if (std::fabs(gb_platform_test_lcd_response_alpha(100000.0f, tau) - 1.0f) > 0.001f) {
+        return fail("alpha must saturate at one");
+    }
+
+    /* 2. The endpoints of the coefficient. Alpha 1 is the target exactly, so
+     *    the trail can always be driven to zero; alpha 0 is the previous frame
+     *    exactly, so a stalled panel freezes rather than drifting. */
+    {
+        if (step(white, argb(137, 42, 200), 1.0f, 1.0f) != argb(137, 42, 200)) {
+            return fail("alpha one must reproduce the target");
+        }
+        if (step(white, argb(137, 42, 200), 0.0f, 0.0f) != white) {
+            return fail("alpha zero must freeze on the previous frame");
+        }
+    }
+
+    /* 3. Frame-rate independence, which is the whole reason the coefficient is
+     *    derived from elapsed time. One 32 ms step and four 8 ms steps must
+     *    land in the same place; a fixed per-frame alpha would not. */
+    {
+        const float a32 = gb_platform_test_lcd_response_alpha(32.0f, tau);
+        const float a8 = gb_platform_test_lcd_response_alpha(8.0f, tau);
+
+        const uint32_t single = step(black, white, a32, a32);
+
+        uint32_t walked = black;
+        for (int i = 0; i < 4; ++i) {
+            walked = step(walked, white, a8, a8);
+        }
+
+        const int diff = (int)red_of(single) - (int)red_of(walked);
+        if (diff < -1 || diff > 1) {
+            std::fprintf(stderr, "FAIL: 1x32ms=%u but 4x8ms=%u\n", red_of(single),
+                         red_of(walked));
+            return 1;
+        }
+        if (red_of(walked) == 0) return fail("the trail must actually move");
+    }
+
+    /* 4. Asymmetry: falling luminance is the fast direction on the real panel,
+     *    and this is what makes the smear read as an LCD rather than as a blur. */
+    {
+        const float dark = gb_platform_test_lcd_response_alpha(16.0f, tau * 0.65f);
+        const float light = gb_platform_test_lcd_response_alpha(16.0f, tau * 1.45f);
+        if (!(dark > light)) return fail("darkening must be the faster direction");
+
+        const uint32_t falling = step(white, black, dark, light);
+        const uint32_t rising = step(black, white, dark, light);
+
+        /* The two directions live on opposite scales - one falls toward zero,
+         * the other rises toward 255 - so compare how far each got toward its
+         * own target rather than comparing the raw levels. */
+        const double fall_progress = (255.0 - (double)red_of(falling)) / 255.0;
+        const double rise_progress = (double)red_of(rising) / 255.0;
+        if (!(fall_progress > rise_progress)) {
+            std::fprintf(stderr, "FAIL: falling %.3f rising %.3f of the way\n",
+                         fall_progress, rise_progress);
+            return 1;
+        }
+        if (rise_progress <= 0.0) return fail("rising must move toward the target");
+    }
+
+    /* 5. It has to land exactly on the guest colour, not asymptotically near it.
+     *    A one-level remainder never closes under rounding, which would leave
+     *    the whole panel a shade off the image permanently. */
+    {
+        const float a = gb_platform_test_lcd_response_alpha(16.0f, tau * 0.65f);
+        uint32_t up = black;
+        for (int i = 0; i < 400; ++i) {
+            up = step(up, white, a, a);
+        }
+        if (up != white) {
+            std::fprintf(stderr, "FAIL: rising settled at %u, expected 255\n",
+                         red_of(up));
+            return 1;
+        }
+        uint32_t down = white;
+        for (int i = 0; i < 400; ++i) {
+            down = step(down, black, a, a);
+        }
+        if (down != black) {
+            std::fprintf(stderr, "FAIL: falling settled at %u, expected 0\n",
+                         red_of(down));
+            return 1;
+        }
+    }
+
+    std::printf("lcd response: ok\n");
+    return 0;
+}
