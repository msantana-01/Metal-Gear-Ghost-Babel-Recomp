+                g_foreign_identity_value.c_str());
+    }
+    fprintf(file, "%s=%d\n", scoped_pref_key("audio.mastering").c_str(),
             g_audio_mastering_enabled.load(std::memory_order_relaxed) ? 1 : 0);
     fprintf(file, "audio.volume_percent=%u\n",
