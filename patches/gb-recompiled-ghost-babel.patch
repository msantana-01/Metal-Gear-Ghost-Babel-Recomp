+/* (Re)builds the panel effect mask. Regenerating costs ~200k pixels and only
+ * happens when the effect, the intensity or the on-screen scale changes. */
+static void update_screen_effect_texture(void) {
+    g_screen_effect_dirty = false;
+    if (!g_renderer) {
+        return;
+    }
+
+    if (g_screen_effect == GB_SCREEN_EFFECT_OFF) {
+        if (g_screen_effect_texture) {
+            SDL_DestroyTexture(g_screen_effect_texture);
+            g_screen_effect_texture = NULL;
+        }
+        return;
+    }
+
+    /* Rasterise the mask at the on-screen scale: one mask pixel per screen
+     * pixel keeps the gap the width it was asked for at every window size. */
+    const float scale_factor = (g_game_viewport.w > 0)
+        ? ((float)g_game_viewport.w / (float)GB_SCREEN_WIDTH)
+        : 1.0f;
+    int lattice = (int)lrintf(scale_factor);
+    if (lattice < GB_SCREEN_EFFECT_MIN_LATTICE) lattice = GB_SCREEN_EFFECT_MIN_LATTICE;
+    if (lattice > GB_SCREEN_EFFECT_MAX_LATTICE) lattice = GB_SCREEN_EFFECT_MAX_LATTICE;
+
+    if (!g_screen_effect_texture || g_screen_effect_lattice != lattice) {
+        if (g_screen_effect_texture) {
+            SDL_DestroyTexture(g_screen_effect_texture);
+            g_screen_effect_texture = NULL;
+        }
+        g_screen_effect_lattice = lattice;
+        g_screen_effect_texture = SDL_CreateTexture(g_renderer,
+                                                    SDL_PIXELFORMAT_ARGB8888,
+                                                    SDL_TEXTUREACCESS_STREAMING,
+                                                    GB_SCREEN_WIDTH * lattice,
+                                                    GB_SCREEN_HEIGHT * lattice);
+        if (!g_screen_effect_texture) {
+            fprintf(stderr, "[SDL] Failed to create the screen effect texture: %s\n",
+                    SDL_GetError());
+            return;
+        }
+        /* The mask is a multiplier: white leaves the guest alone, grey darkens
+         * it. Nearest keeps the gap crisp - smoothing it would blur the very
+         * grid this is drawing. */
+        SDL_SetTextureScaleMode(g_screen_effect_texture, SDL_ScaleModeNearest);
+        SDL_SetTextureBlendMode(g_screen_effect_texture, SDL_BLENDMODE_MUL);
+    }
+
+    void* pixels = NULL;
+    int pitch = 0;
+    if (SDL_LockTexture(g_screen_effect_texture, NULL, &pixels, &pitch) != 0) {
+        fprintf(stderr, "[SDL] Failed to lock the screen effect texture: %s\n",
+                SDL_GetError());
+        return;
+    }
+    compute_screen_effect_overlay((uint32_t*)pixels, GB_SCREEN_WIDTH * lattice,
+                                  GB_SCREEN_HEIGHT * lattice,
+                                  (int)g_screen_effect, g_screen_effect_intensity,
+                                  scale_factor);
