+/* alpha for a given elapsed time and response time constant: the exact
+ * solution of du/dt = (u_target - u)/tau, sampled at dt. */
+static float lcd_response_alpha(float dt_ms, float tau_ms) {
+    if (tau_ms <= 0.0f) {
+        return 1.0f;
+    }
+    return 1.0f - expf(-(dt_ms / tau_ms));
+}
