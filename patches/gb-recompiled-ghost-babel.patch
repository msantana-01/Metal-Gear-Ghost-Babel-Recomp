+/* Unit tests for QOL runtime helpers:
+ *  - RGB565 savestate sidecar thumbnails (GBTH) write/read & corrupt rejection
+ *  - Audio Dynamic Rate Control ratio clamping and wrap-around resampling
+ *  - APU CH4 rumble trigger snapshot & savestate size invariance
+ */
+
+#include "audio.h"
+#include "platform_sdl.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace fs = std::filesystem;
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool condition, const char* what) {
+    if (!condition) {
+        std::printf("FAIL %s\n", what);
+        g_failures++;
+    }
+}
+
+void test_savestate_thumbnails() {
+    const fs::path base =
+        fs::temp_directory_path() / "gb_recomp_test_qol_slot.state1";
+    const fs::path thumb = fs::path(base.string() + ".thumb");
+    std::error_code ec;
+    fs::remove(base, ec);
+    fs::remove(thumb, ec);
+
+    constexpr int W = 256;
+    constexpr int H = 144;
+    std::vector<uint32_t> argb((size_t)W * (size_t)H, 0xFF000000u);
+    for (int y = 0; y < H; ++y) {
+        for (int x = 0; x < W; ++x) {
+            const uint8_t r = (uint8_t)((x * 255) / (W - 1));
+            const uint8_t g = (uint8_t)((y * 255) / (H - 1));
+            const uint8_t b = (uint8_t)(((x ^ y) * 3) & 0xFF);
+            argb[(size_t)y * W + (size_t)x] =
+                0xFF000000u | ((uint32_t)r << 16) | ((uint32_t)g << 8) | b;
+        }
+    }
+
+    check(gb_platform_test_write_savestate_thumbnail(base.string().c_str(), argb.data(), W, H),
+          "thumbnail sidecar writes cleanly");
+    check(fs::exists(thumb, ec), "thumbnail sidecar exists at .thumb");
+    check(fs::file_size(thumb, ec) == 12u + (size_t)W * (size_t)H * 2u,
+          "thumbnail sidecar has exact expected size");
+
+    std::vector<uint16_t> loaded((size_t)W * (size_t)H, 0);
+    int out_w = 0;
+    int out_h = 0;
+    check(gb_platform_test_read_savestate_thumbnail(
+              base.string().c_str(), loaded.data(), loaded.size(), &out_w, &out_h),
+          "thumbnail sidecar reads back validly");
+    check(out_w == W && out_h == H, "thumbnail preserves exact 256x144 geometry");
+
+    bool rgb565_exact = true;
+    for (size_t i = 0; i < loaded.size(); ++i) {
+        const uint32_t px = argb[i];
+        const uint16_t r = (uint16_t)((px >> 16) & 0xFFu);
+        const uint16_t g = (uint16_t)((px >> 8) & 0xFFu);
+        const uint16_t b = (uint16_t)(px & 0xFFu);
+        const uint16_t want =
+            (uint16_t)(((r & 0xF8u) << 8) | ((g & 0xFCu) << 3) | (b >> 3));
+        if (loaded[i] != want) {
+            rgb565_exact = false;
+            break;
+        }
+    }
+    check(rgb565_exact, "thumbnail roundtrip matches RGB565 conversion bit-for-bit");
+
+    /* Reject bad magic */
+    {
+        FILE* f = std::fopen(thumb.string().c_str(), "r+b");
+        check(f != nullptr, "open thumb for magic corruption");
+        if (f) {
+            const uint8_t bad[4] = {'X', 'Y', 'Z', '!'};
+            std::fwrite(bad, 1, 4, f);
+            std::fclose(f);
+        }
+        check(!gb_platform_test_read_savestate_thumbnail(
+                  base.string().c_str(), loaded.data(), loaded.size(), &out_w, &out_h),
+              "corrupt magic thumbnail is rejected");
+    }
+
+    /* Reject oversized dimensions or truncated payload */
+    {
+        FILE* f = std::fopen(thumb.string().c_str(), "wb");
+        if (f) {
+            const uint8_t bad_hdr[12] = {'G', 'B', 'T', 'H', 0x00, 0x10, 0x90, 0x00, 1, 0, 0, 0};
+            std::fwrite(bad_hdr, 1, sizeof(bad_hdr), f);
+            std::fclose(f);
+        }
+        check(!gb_platform_test_read_savestate_thumbnail(
+                  base.string().c_str(), loaded.data(), loaded.size(), &out_w, &out_h),
+              "oversized/truncated thumbnail is rejected");
+    }
+
+    /* Reject out-of-range write request */
+    check(!gb_platform_test_write_savestate_thumbnail(base.string().c_str(), argb.data(), 512, 144),
+          "out-of-bounds thumbnail write width is refused");
+
+    fs::remove(base, ec);
+    fs::remove(thumb, ec);
+}
+
+void test_drc_rate_and_resampler() {
+    const float eq = gb_platform_test_compute_drc_ratio(2048u, 2048u, 0.015f);
+    check(std::fabs(eq - 1.0f) < 1e-6f, "DRC ratio is exactly 1.0 at target fill");
+
+    const float high = gb_platform_test_compute_drc_ratio(16000u, 2048u, 0.015f);
+    check(std::fabs(high - 1.015f) < 1e-6f, "DRC ratio clamps upper skew to +max_skew");
+
+    const float low = gb_platform_test_compute_drc_ratio(0u, 2048u, 0.015f);
+    check(std::fabs(low - 0.985f) < 1e-6f, "DRC ratio clamps lower skew to -max_skew");
+
+    /* Ring wrap-around interpolation over monotonic ramp */
+    constexpr uint32_t kRingSize = 16;
+    int16_t ring[kRingSize * 2] = {};
+    const uint32_t read_pos = 12;
+    const uint32_t available = 10;
+    for (uint32_t i = 0; i < available; ++i) {
+        const uint32_t idx = (read_pos + i) % kRingSize;
+        ring[idx * 2] = (int16_t)(i * 1000);
+        ring[idx * 2 + 1] = (int16_t)(-(int32_t)i * 500);
+    }
+
+    double phase = 0.0;
+    int16_t out[16] = {};
+    uint32_t consumed = 0;
+    const uint32_t produced = gb_platform_test_resample_stereo_block(
+        ring, kRingSize, read_pos, available, 1.005, &phase, out, 8u, 1.0f, &consumed);
+    check(produced == 8u, "resampler produces requested frames when ring has enough data");
+    check(consumed == 8u, "resampler reports integer ring consumption");
+    check(phase >= 0.0 && phase < 1.0, "resampler preserves fractional phase in [0, 1)");
+
+    bool monotonic = true;
+    for (uint32_t i = 1; i < produced; ++i) {
+        if (out[i * 2] <= out[(i - 1) * 2] || out[i * 2 + 1] >= out[(i - 1) * 2 + 1]) {
+            monotonic = false;
+            break;
+        }
+    }
+    check(monotonic, "wrapped stereo ramp stays strictly monotonic through linear interpolation");
+
+    /* Exhaustion safety: never read past available */
+    double phase2 = 0.25;
+    int16_t short_out[16] = {};
+    uint32_t consumed2 = 0;
+    const uint32_t produced2 = gb_platform_test_resample_stereo_block(
+        ring, kRingSize, read_pos, 3u, 1.005, &phase2, short_out, 8u, 1.0f, &consumed2);
+    check(produced2 <= 3u, "resampler stops cleanly at available boundary");
+    check(consumed2 == 3u && phase2 == 0.0, "resampler clears phase on exhaustion");
+}
+
+void test_audio_rumble_metrics() {
+    GBContext ctx = {};
+    ctx.apu = gb_audio_create();
+    check(ctx.apu != nullptr, "APU created");
+    if (!ctx.apu) {
+        return;
+    }
+
+    const size_t blob_size = gb_audio_state_size();
+    std::vector<uint8_t> saved(blob_size, 0);
+
+    /* Power on APU */
+    gb_audio_write(&ctx, 0xFF26, 0x80);
+    gb_audio_write(&ctx, 0xFF21, 0xF2); /* NR42: vol=15, DAC on */
+    gb_audio_write(&ctx, 0xFF22, 0x64); /* NR43: shift=6, 15-bit LFSR */
+    gb_audio_write(&ctx, 0xFF23, 0x80); /* Trigger CH4 */
+
+    GBAudioRumbleState st = {};
+    gb_audio_get_rumble_state(ctx.apu, &st);
+    check(st.ch4_enabled, "CH4 enabled after trigger");
+    check(st.ch4_volume == 15, "CH4 volume matches NR42 top nibble");
+    check(st.ch4_clock_shift == 6, "CH4 clock shift matches NR43 >> 4");
+    check(!st.ch4_width_7bit, "CH4 width bit reflects 15-bit noise");
+    check(st.ch4_trigger_count == 1u, "CH4 trigger counter increments on trigger");
+
+    /* Second trigger with 7-bit metallic width and shift 3 */
+    gb_audio_write(&ctx, 0xFF22, 0x38);
+    gb_audio_write(&ctx, 0xFF23, 0x80);
+    gb_audio_get_rumble_state(ctx.apu, &st);
+    check(st.ch4_trigger_count == 2u, "second CH4 trigger increments counter");
+    check(st.ch4_clock_shift == 3, "CH4 clock shift updated");
+    check(st.ch4_width_7bit, "CH4 7-bit width flag set");
+
+    /* Savestate roundtrip must still serialize GBAudio cleanly and clear runtime counter */
+    check(gb_audio_save_state(ctx.apu, saved.data(), saved.size()), "audio save state succeeds");
+    check(gb_audio_load_state(ctx.apu, saved.data(), saved.size()), "audio load state succeeds");
+    gb_audio_get_rumble_state(ctx.apu, &st);
+    check(st.ch4_trigger_count == 0u, "audio load state zeroes runtime trigger counter");
+
+    gb_audio_destroy(ctx.apu);
+}
+
+}  // namespace
+
+int main() {
+    test_savestate_thumbnails();
+    test_drc_rate_and_resampler();
+    test_audio_rumble_metrics();
+    if (g_failures > 0) {
+        std::printf("qol_features: %d failure(s)\n", g_failures);
