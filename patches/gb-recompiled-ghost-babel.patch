-/* Compiles a single shader stage from source. Returns 0 on failure. */
-static GLuint opengl_compile_shader(GLenum type, const char* source) {
-    GLuint shader = glCreateShader_fn(type);
-    if (!shader) {
-        fprintf(stderr, "[SDL] Failed to create OpenGL shader\n");
-        return 0;
-    }
-    glShaderSource_fn(shader, 1, &source, NULL);
-    glCompileShader_fn(shader);
-    GLint ok = 0;
-    glGetShaderiv_fn(shader, GL_COMPILE_STATUS, &ok);
-    if (!ok) {
-        GLint log_len = 0;
-        glGetShaderiv_fn(shader, GL_INFO_LOG_LENGTH, &log_len);
-        if (log_len > 1) {
-            char* log = (char*)SDL_malloc((size_t)log_len);
-            if (log) {
-                glGetShaderInfoLog_fn(shader, log_len, NULL, log);
-                fprintf(stderr, "[SDL] Shader compile error:\n%s\n", log);
-                SDL_free(log);
-            }
-        }
-        glDeleteShader_fn(shader);
-        return 0;
-    }
-    return shader;
-}
