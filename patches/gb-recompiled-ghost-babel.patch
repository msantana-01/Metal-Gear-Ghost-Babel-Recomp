+                const float lin_to = srgb_lut[to];
+                const float lin_val = lin_from + (lin_to - lin_from) * alpha;
+                float value = lcd_linear_to_srgb_byte(lin_val);
                 /* Snap once the remainder is under a level. Without this a
                  * one-level difference never closes - the step is smaller than
                  * the rounding - and the panel settles a shade below the guest
diff --git a/tests/test_lcd_response.cpp b/tests/test_lcd_response.cpp
