+/* Phosphor glow: what is above a threshold, blurred into a halo, scaled back.
+ *
+ * Written as an add rather than folded into the multiply mask because a halo is
+ * brighter than the pixel that produced it, and a multiplier can only ever
+ * darken. Working at guest resolution and letting the upscale spread it means
+ * the glow scales with the image the way the LCD grid does, and the linear
+ * filtering on the texture is what turns each pixel into a soft blob instead of
+ * a block at 4K.
+ *
+ * Separable tent kernel, edges replicated. Replicating rather than zeroing
+ * matters: a zeroed edge would darken the halo along the screen border into a
+ * visible vignette that has nothing to do with the effect.
+ */
+#define GB_GLOW_RADIUS 3
+static const int g_glow_tent[GB_GLOW_RADIUS + 1] = {4, 3, 2, 1};
+/* 1+2+3+4+3+2+1 from the tent above. Tied to that array deliberately: a wrong
+ * sum does not crash or look obviously wrong, it just quietly scales the whole
+ * effect, and two passes compound it into a square. */
+#define GB_GLOW_TENT_SUM 16
+
+static void compute_phosphor_glow(const uint32_t* src, int src_pitch_bytes,
+                                  uint32_t* dst, uint32_t* scratch, int width,
+                                  int height, int threshold, int amount) {
+    const int centre = GB_GLOW_RADIUS;
+    /* Threshold into scratch, then blur each axis in turn: separable, so the
+     * halo costs 2 passes of 7 taps instead of a 7x7 kernel. */
+    for (int y = 0; y < height; ++y) {
+        const uint32_t* row =
+            (const uint32_t*)((const uint8_t*)src + (size_t)y * (size_t)src_pitch_bytes);
+        for (int x = 0; x < width; ++x) {
+            uint32_t out = 0xFF000000u;
+            for (int shift = 16; shift >= 0; shift -= 8) {
+                const uint32_t level = (row[x] >> shift) & 0xFFu;
+                const uint32_t excess =
+                    (level > (uint32_t)threshold) ? (level - (uint32_t)threshold) : 0u;
+                out |= (excess & 0xFFu) << shift;
+            }
+            scratch[(size_t)y * (size_t)width + x] = out;
+        }
+    }
+    for (int y = 0; y < height; ++y) {
+        uint32_t* out_row = dst + (size_t)y * (size_t)width;
+        for (int x = 0; x < width; ++x) {
+            uint32_t out = 0xFF000000u;
+            for (int shift = 16; shift >= 0; shift -= 8) {
+                int total = 0;
+                for (int d = -centre; d <= centre; ++d) {
+                    int sx = x + d;
+                    if (sx < 0) sx = 0;
+                    if (sx >= width) sx = width - 1;
+                    total += (int)((scratch[(size_t)y * (size_t)width + sx] >> shift) & 0xFFu) *
+                             g_glow_tent[(d < 0) ? -d : d];
+                }
+                out |= ((uint32_t)(total / GB_GLOW_TENT_SUM) & 0xFFu) << shift;
+            }
+            out_row[x] = out;
+        }
+    }
+    for (int y = 0; y < height; ++y) {
+        uint32_t* out_row = dst + (size_t)y * (size_t)width;
+        for (int x = 0; x < width; ++x) {
+            uint32_t out = 0xFF000000u;
+            for (int shift = 16; shift >= 0; shift -= 8) {
+                int total = 0;
+                for (int d = -centre; d <= centre; ++d) {
+                    int sy = y + d;
+                    if (sy < 0) sy = 0;
+                    if (sy >= height) sy = height - 1;
+                    total += (int)((dst[(size_t)sy * (size_t)width + x] >> shift) & 0xFFu) *
+                             g_glow_tent[(d < 0) ? -d : d];
+                }
+                out |= ((uint32_t)(total / GB_GLOW_TENT_SUM) & 0xFFu) << shift;
+            }
+            out_row[x] = out;
+        }
+    }
+    if (amount != 100) {
+        for (int i = 0; i < width * height; ++i) {
+            const uint32_t v = dst[i];
+            uint32_t out = 0xFF000000u;
+            for (int shift = 16; shift >= 0; shift -= 8) {
+                int scaled = (int)(((v >> shift) & 0xFFu) * amount) / 100;
+                if (scaled > 255) scaled = 255;
+                out |= ((uint32_t)scaled & 0xFFu) << shift;
+            }
+            dst[i] = out;
+        }
+    }
+}
+
+/* The glow lives in its own texture because it has to be composited with
+ * SDL_BLENDMODE_ADD, and a texture carries one blend mode. */
+static bool ensure_glow_texture(void) {
+    if (g_glow_texture || !g_renderer) {
+        return g_glow_texture != NULL;
+    }
+    g_glow_texture = SDL_CreateTexture(g_renderer, SDL_PIXELFORMAT_ARGB8888,
+                                       SDL_TEXTUREACCESS_STREAMING, GB_SCREEN_WIDTH,
+                                       GB_SCREEN_HEIGHT);
+    if (!g_glow_texture) {
+        fprintf(stderr, "[SDL] Failed to create the glow texture: %s\n", SDL_GetError());
+        return false;
+    }
+    /* Linear, and deliberately so while the guest texture may be Nearest: the
+     * point of the upscale is to turn each pixel into a soft blob. Nearest here
+     * would give hard blocks at 4K. */
+    SDL_SetTextureScaleMode(g_glow_texture, SDL_ScaleModeLinear);
+    SDL_SetTextureBlendMode(g_glow_texture, SDL_BLENDMODE_ADD);
+    return true;
+}
