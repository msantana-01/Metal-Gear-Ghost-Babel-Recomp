     ImGui_ImplSDLRenderer2_NewFrame();
@@ -3331,6 +3481,7 @@ ImGui::PushItemWidth(ImGui::GetContentRegionAvail().x * 0.55f);
     g_last_timing.compose_ms = sdl_now_ms() - compose_start_ms;
 
