-/* Embedded GLSL shader sources (CRT effect). Stored as plain C strings so the
- * file compiles as both C and C++ (the runtime target mixes C and C++ files). */
-static const char* g_crt_vertex_shader =
-    "#version 330 core\n"
-    "\n"
-    "layout(location = 0) in vec2 aPos;\n"
-    "layout(location = 1) in vec2 aTexCoord;\n"
-    "\n"
-    "out vec2 TexCoord;\n"
-    "\n"
-    "uniform mat4 u_projection;\n"
-    "\n"
-    "void main() {\n"
-    "    gl_Position = u_projection * vec4(aPos, 0.0, 1.0);\n"
-    "    TexCoord = aTexCoord;\n"
-    "}\n";
-
-static const char* g_crt_fragment_shader =
-    "#version 330 core\n"
-    "\n"
-    "in vec2 TexCoord;\n"
-    "out vec4 FragColor;\n"
-    "\n"
-    "uniform sampler2D u_texture;\n"
-    "uniform float u_intensity;\n"
-    "uniform float u_time;\n"
-    "uniform vec2 u_resolution;\n"
-    "\n"
-    "float scanline(float y, float amount, float soft) {\n"
-    "    float gap = 0.22f;\n"
-    "    float t = fract(y * 1.0f);\n"
-    "    float edge = 1.0f - gap;\n"
-    "    float ramp = smoothstep(edge, edge + soft, t);\n"
-    "    return amount * ramp;\n"
-    "}\n"
-    "\n"
-    "vec3 chromatic_aberration(sampler2D tex, vec2 uv, float amount, vec2 resolution) {\n"
-    "    float strength = amount * 0.004f;\n"
-    "    vec2 offset = (uv - 0.5f) * strength;\n"
-    "    float r = texture(tex, uv + offset).r;\n"
-    "    float g = texture(tex, uv).g;\n"
-    "    float b = texture(tex, uv - offset).b;\n"
-    "    return vec3(r, g, b);\n"
-    "}\n"
-    "\n"
-    "float vignette(vec2 uv, float amount) {\n"
-    "    vec2 center = vec2(0.5f);\n"
-    "    float dist = distance(uv, center);\n"
-    "    return 1.0f - amount * dist * dist * 0.5f;\n"
-    "}\n"
-    "\n"
-    "vec3 phosphor_glow(vec3 color, float amount) {\n"
-    "    float luminance = dot(color, vec3(0.299f, 0.587f, 0.114f));\n"
-    "    float glow = smoothstep(0.75f, 1.0f, luminance);\n"
-    "    vec3 warm = vec3(1.0f, 0.9f, 0.7f);\n"
-    "    return color + glow * warm * amount * 0.3f;\n"
-    "}\n"
-    "\n"
-    "void main() {\n"
-    "    vec2 uv = TexCoord;\n"
-    "    vec4 tex = texture(u_texture, uv);\n"
-    "    vec3 color = tex.rgb;\n"
-    "    float amt = clamp(u_intensity, 0.0f, 1.0f);\n"
-    "    float line = scanline(uv.y, amt, 0.08f);\n"
-    "    color *= (1.0f - line);\n"
-    "    if (amt > 0.1f) {\n"
-    "        color = chromatic_aberration(u_texture, uv, amt, u_resolution);\n"
-    "    }\n"
-    "    color *= vignette(uv, amt * 0.15f);\n"
-    "    if (amt > 0.2f) {\n"
-    "        color = phosphor_glow(color, amt);\n"
-    "    }\n"
-    "    FragColor = vec4(color, tex.a);\n"
-    "}\n";
-
-static bool opengl_init_shader(void) {
-    GLuint vert = opengl_compile_shader(GL_VERTEX_SHADER, g_crt_vertex_shader);
-    GLuint frag = opengl_compile_shader(GL_FRAGMENT_SHADER, g_crt_fragment_shader);
-    if (!vert || !frag) {
-        if (vert) glDeleteShader_fn(vert);
-        if (frag) glDeleteShader_fn(frag);
-        return false;
-    }
-
-    g_shader_program = glCreateProgram_fn();
-    glAttachShader_fn(g_shader_program, vert);
-    glAttachShader_fn(g_shader_program, frag);
-    glLinkProgram_fn(g_shader_program);
-
-    GLint ok = 0;
-    glGetProgramiv_fn(g_shader_program, GL_LINK_STATUS, &ok);
-    if (!ok) {
-        GLint log_len = 0;
-        glGetProgramiv_fn(g_shader_program, GL_INFO_LOG_LENGTH, &log_len);
-        if (log_len > 1) {
-            char* log = (char*)SDL_malloc((size_t)log_len);
-            if (log) {
-                glGetProgramInfoLog_fn(g_shader_program, log_len, NULL, log);
-                fprintf(stderr, "[SDL] Shader link error:\n%s\n", log);
-                SDL_free(log);
-            }
-        }
-        glDeleteProgram_fn(g_shader_program);
-        g_shader_program = 0;
-        glDeleteShader_fn(vert);
-        glDeleteShader_fn(frag);
-        return false;
-    }
-
-    glDeleteShader_fn(vert);
-    glDeleteShader_fn(frag);
-
-    g_shader_loc_texture = glGetUniformLocation_fn == NULL ? -1 : -1;
-    /* Uniform locations are queried after linking; store them lazily on first
-     * use to avoid calling glGetUniformLocation before the program is bound. */
-    g_shader_loc_texture = -1;
-    g_shader_loc_intensity = -1;
-    g_shader_loc_time = -1;
-    g_shader_loc_resolution = -1;
-    return true;
-}
