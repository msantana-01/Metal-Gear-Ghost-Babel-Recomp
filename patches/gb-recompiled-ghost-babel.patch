+    static const char* k_vertex_shader_src =
+        "#version 120\n"
+        "varying vec2 vTexCoord;\n"
+        "void main() {\n"
+        "    vTexCoord = gl_MultiTexCoord0.xy;\n"
+        "    gl_Position = vec4(gl_Vertex.xy, 0.0, 1.0);\n"
+        "}\n";
+
+    /* Public Domain CRT-Lottes (Timothy Lottes) single-pass CRT shader +
+     * GBC TFT LCD subpixel & color-matrix mode. */
+    static const char* k_fragment_shader_src =
+        "#version 120\n"
+        "uniform sampler2D uTexture;\n"
+        "uniform vec2 uSourceSize;\n"
+        "uniform vec2 uOutputSize;\n"
+        "uniform vec2 uTexCoordScale;\n"
+        "uniform float uStrength;\n"
+        "uniform float uMode;\n"
+        "varying vec2 vTexCoord;\n"
+        "\n"
+        "float ToLinear1(float c) {\n"
+        "    c = clamp(c, 0.0, 1.0);\n"
+        "    return (c <= 0.04045) ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4);\n"
+        "}\n"
+        "vec3 ToLinear(vec3 c) {\n"
+        "    return vec3(ToLinear1(c.r), ToLinear1(c.g), ToLinear1(c.b));\n"
+        "}\n"
+        "float ToSrgb1(float c) {\n"
+        "    c = clamp(c, 0.0, 1.0);\n"
+        "    return (c <= 0.0031308) ? (c * 12.92) : (1.055 * pow(c, 0.4166667) - 0.055);\n"
+        "}\n"
+        "vec3 ToSrgb(vec3 c) {\n"
+        "    return vec3(ToSrgb1(c.r), ToSrgb1(c.g), ToSrgb1(c.b));\n"
+        "}\n"
+        "\n"
+        "vec3 Fetch(vec2 pos, vec2 off) {\n"
+        "    vec2 texel = floor(pos * uSourceSize + off) + vec2(0.5);\n"
+        "    if (texel.x < 0.0 || texel.x > uSourceSize.x ||\n"
+        "        texel.y < 0.0 || texel.y > uSourceSize.y) {\n"
+        "        return vec3(0.0);\n"
+        "    }\n"
+        "    vec2 uv = (texel / uSourceSize) * uTexCoordScale;\n"
+        "    return ToLinear(texture2D(uTexture, uv).rgb);\n"
+        "}\n"
+        "\n"
+        "vec2 Dist(vec2 pos) {\n"
+        "    vec2 p = pos * uSourceSize;\n"
+        "    return -((p - floor(p)) - vec2(0.5));\n"
+        "}\n"
+        "\n"
+        "float Gaus(float d, float scale) {\n"
+        "    return exp2(scale * d * d);\n"
+        "}\n"
+        "\n"
+        "vec3 Horiz3(vec2 pos, float offY, float hardPix) {\n"
+        "    float dx = Dist(pos).x;\n"
+        "    float wa = Gaus(dx - 1.0, hardPix);\n"
+        "    float wb = Gaus(dx,       hardPix);\n"
+        "    float wc = Gaus(dx + 1.0, hardPix);\n"
+        "    vec3 a = Fetch(pos, vec2(-1.0, offY));\n"
+        "    vec3 b = Fetch(pos, vec2( 0.0, offY));\n"
+        "    vec3 c = Fetch(pos, vec2( 1.0, offY));\n"
+        "    return (a * wa + b * wb + c * wc) / (wa + wb + wc);\n"
+        "}\n"
+        "\n"
+        "vec3 Horiz5(vec2 pos, float offY, float hardPix) {\n"
+        "    float dx = Dist(pos).x;\n"
+        "    float w0 = Gaus(dx - 2.0, hardPix);\n"
+        "    float w1 = Gaus(dx - 1.0, hardPix);\n"
+        "    float w2 = Gaus(dx,       hardPix);\n"
+        "    float w3 = Gaus(dx + 1.0, hardPix);\n"
+        "    float w4 = Gaus(dx + 2.0, hardPix);\n"
+        "    vec3 c = Fetch(pos, vec2(-2.0, offY)) * w0 +\n"
+        "             Fetch(pos, vec2(-1.0, offY)) * w1 +\n"
+        "             Fetch(pos, vec2( 0.0, offY)) * w2 +\n"
+        "             Fetch(pos, vec2( 1.0, offY)) * w3 +\n"
+        "             Fetch(pos, vec2( 2.0, offY)) * w4;\n"
+        "    return c / (w0 + w1 + w2 + w3 + w4);\n"
+        "}\n"
+        "\n"
+        "float ScanWeight(float dy, float offY, float hardScan, vec3 lineColor) {\n"
+        "    float luma = max(lineColor.r, max(lineColor.g, lineColor.b));\n"
+        "    float s = mix(hardScan, hardScan * 0.72, luma);\n"
+        "    return Gaus(dy + offY, s);\n"
+        "}\n"
+        "\n"
+        "vec3 BloomRow(vec2 pos, vec2 dist, float offY, float hardBloomScan, float hardBloomPix) {\n"
+        "    return Horiz5(pos, offY, hardBloomPix) * Gaus(dist.y + offY, hardBloomScan);\n"
+        "}\n"
+        "\n"
+        "vec3 CalcBloom(vec2 pos) {\n"
+        "    vec2 dist = Dist(pos);\n"
+        "    float hbs = -2.0;\n"
+        "    float hbp = -1.6;\n"
+        "    vec3 b = BloomRow(pos, dist, -1.0, hbs, hbp) +\n"
+        "             BloomRow(pos, dist,  0.0, hbs, hbp) +\n"
+        "             BloomRow(pos, dist,  1.0, hbs, hbp);\n"
+        "    return b / 3.0;\n"
+        "}\n"
+        "\n"
+        "vec2 Warp(vec2 uv, vec2 warp) {\n"
+        "    vec2 p = uv * 2.0 - 1.0;\n"
+        "    p *= vec2(1.0 + (p.y * p.y) * warp.x,\n"
+        "              1.0 + (p.x * p.x) * warp.y);\n"
+        "    return p * 0.5 + 0.5;\n"
+        "}\n"
+        "\n"
+        "vec3 ApertureGrilleMask(vec2 frag, float dark, float light) {\n"
+        "    float m = mod(floor(frag.x), 3.0);\n"
+        "    if (m < 0.5) return vec3(light, dark, dark);\n"
+        "    if (m < 1.5) return vec3(dark, light, dark);\n"
+        "    return vec3(dark, dark, light);\n"
+        "}\n"
+        "\n"
+        "vec3 SlotMask(vec2 frag, float dark, float light) {\n"
+        "    float col = floor(frag.x);\n"
+        "    float cellX = floor(col / 3.0);\n"
+        "    float m = col - cellX * 3.0;\n"
+        "    vec3 mask = (m < 0.5) ? vec3(light, dark, dark)\n"
+        "              : ((m < 1.5) ? vec3(dark, light, dark)\n"
+        "                           : vec3(dark, dark, light));\n"
+        "    float rowPhase = mod(floor(frag.y) + mod(cellX, 2.0) * 2.0, 4.0);\n"
+        "    if (rowPhase >= 3.0) {\n"
+        "        mask *= mix(dark, 1.0, 0.35);\n"
+        "    }\n"
+        "    return mask;\n"
+        "}\n"
+        "\n"
+        "vec3 RenderCRT(vec2 uv, bool curved, float strength) {\n"
+        "    vec2 pos = uv;\n"
+        "    float bezel = 1.0;\n"
+        "    if (curved) {\n"
+        "        vec2 warp = vec2(0.018, 0.026) * mix(0.60, 1.0, strength);\n"
+        "        pos = Warp(uv, warp);\n"
+        "        vec2 edge = min(pos, vec2(1.0) - pos);\n"
+        "        vec2 px = edge * uOutputSize;\n"
+        "        float corner = min(px.x, px.y);\n"
+        "        bezel = smoothstep(0.0, 2.5, corner);\n"
+        "        vec2 centered = pos * 2.0 - 1.0;\n"
+        "        float radius = length(max(abs(centered) - vec2(0.96), 0.0));\n"
+        "        bezel *= 1.0 - smoothstep(0.025, 0.045, radius);\n"
+        "        if (pos.x < 0.0 || pos.x > 1.0 || pos.y < 0.0 || pos.y > 1.0) {\n"
+        "            return vec3(0.0);\n"
+        "        }\n"
+        "    }\n"
+        "    float hardPix = mix(-3.6, -2.2, strength);\n"
+        "    float hardScan = mix(-7.0, -12.0, strength);\n"
+        "    vec3 a = Horiz3(pos, -1.0, hardPix);\n"
+        "    vec3 b = Horiz3(pos,  0.0, hardPix);\n"
+        "    vec3 c = Horiz3(pos,  1.0, hardPix);\n"
+        "    if (curved) {\n"
+        "        float conv = 0.14 * strength / uSourceSize.x;\n"
+        "        float ar = Horiz3(pos - vec2(conv, 0.0), -1.0, hardPix).r;\n"
+        "        float br = Horiz3(pos - vec2(conv, 0.0),  0.0, hardPix).r;\n"
+        "        float cr = Horiz3(pos - vec2(conv, 0.0),  1.0, hardPix).r;\n"
+        "        float ab = Horiz3(pos + vec2(conv, 0.0), -1.0, hardPix).b;\n"
+        "        float bb = Horiz3(pos + vec2(conv, 0.0),  0.0, hardPix).b;\n"
+        "        float cb = Horiz3(pos + vec2(conv, 0.0),  1.0, hardPix).b;\n"
+        "        a.r = ar; b.r = br; c.r = cr;\n"
+        "        a.b = ab; b.b = bb; c.b = cb;\n"
+        "    }\n"
+        "    float dy = Dist(pos).y;\n"
+        "    vec3 col = a * ScanWeight(dy, -1.0, hardScan, a) +\n"
+        "               b * ScanWeight(dy,  0.0, hardScan, b) +\n"
+        "               c * ScanWeight(dy,  1.0, hardScan, c);\n"
+        "    float bloomAmt = mix(curved ? 0.06 : 0.04, curved ? 0.16 : 0.12, strength);\n"
+        "    col += CalcBloom(pos) * bloomAmt;\n"
+        "    float maskDark = mix(0.88, 0.58, strength);\n"
+        "    float maskLight = mix(1.06, 1.24, strength);\n"
+        "    vec3 mask = curved ? SlotMask(gl_FragCoord.xy, maskDark, maskLight)\n"
+        "                       : ApertureGrilleMask(gl_FragCoord.xy, maskDark, maskLight);\n"
+        "    col *= mask;\n"
+        "    vec2 vc = pos * 2.0 - 1.0;\n"
+        "    float vig = 1.0 - (curved ? 0.16 : 0.07) * strength * dot(vc, vc);\n"
+        "    col *= clamp(vig, 0.72, 1.0);\n"
+        "    float boost = curved ? mix(1.04, 1.24, strength) : mix(1.03, 1.20, strength);\n"
+        "    col *= boost * bezel;\n"
+        "    return ToSrgb(col);\n"
+        "}\n"
+        "\n"
+        "vec3 RenderGBCLCD(vec2 uv, float strength) {\n"
+        "    vec2 pxPerGuest = uOutputSize / max(uSourceSize, vec2(1.0));\n"
+        "    vec2 texelPos = uv * uSourceSize;\n"
+        "    vec2 centerTexel = (floor(texelPos) + vec2(0.5)) / uSourceSize;\n"
+        "    vec3 rawLin = ToLinear(texture2D(uTexture, clamp(centerTexel, 0.0, 1.0) * uTexCoordScale).rgb);\n"
+        "    vec3 gbcMat = vec3(\n"
+        "        dot(rawLin, vec3(0.80, 0.15, 0.05)),\n"
+        "        dot(rawLin, vec3(0.06, 0.72, 0.22)),\n"
+        "        dot(rawLin, vec3(0.04, 0.14, 0.82))\n"
+        "    );\n"
+        "    vec3 colorLin = mix(rawLin, gbcMat, mix(0.35, 1.0, strength));\n"
+        "    vec2 sub = fract(texelPos);\n"
+        "    vec2 border = clamp(vec2(1.1) / max(pxPerGuest, vec2(1.0)), vec2(0.05), vec2(0.22));\n"
+        "    vec2 aa = clamp(vec2(0.65) / max(pxPerGuest, vec2(1.0)), vec2(0.01), vec2(0.10));\n"
+        "    float gx = smoothstep(0.0, border.x + aa.x, sub.x) *\n"
+        "               (1.0 - smoothstep(1.0 - border.x - aa.x, 1.0, sub.x));\n"
+        "    float gy = smoothstep(0.0, border.y + aa.y, sub.y) *\n"
+        "               (1.0 - smoothstep(1.0 - border.y - aa.y, 1.0, sub.y));\n"
+        "    float cellMask = gx * gy;\n"
+        "    float gridVis = smoothstep(1.6, 3.0, min(pxPerGuest.x, pxPerGuest.y));\n"
+        "    float gridGain = mix(1.0, mix(mix(0.84, 0.66, strength), 1.0, cellMask), gridVis);\n"
+        "    float subVis = smoothstep(2.5, 4.5, pxPerGuest.x);\n"
+        "    float sCol = fract(sub.x * 3.0);\n"
+        "    float gapSub = 1.0 - 0.16 * strength * (1.0 - smoothstep(0.10, 0.25, min(sCol, 1.0 - sCol)));\n"
+        "    float subTint = 1.0 - 0.12 * strength;\n"
+        "    vec3 rgbSub = (sub.x < 0.33333) ? vec3(1.08, subTint, subTint)\n"
+        "                : ((sub.x < 0.66667) ? vec3(subTint, 1.08, subTint)\n"
+        "                                     : vec3(subTint, subTint, 1.08));\n"
+        "    vec3 subMask = mix(vec3(1.0), rgbSub * gapSub, subVis);\n"
+        "    float boost = mix(1.02, 1.18, strength * gridVis);\n"
+        "    vec3 col = colorLin * gridGain * subMask * boost;\n"
+        "    return ToSrgb(col);\n"
+        "}\n"
+        "\n"
+        "void main() {\n"
+        "    vec3 outColor;\n"
+        "    if (uMode < 0.5) {\n"
+        "        outColor = RenderCRT(vTexCoord, false, uStrength);\n"
+        "    } else if (uMode < 1.5) {\n"
+        "        outColor = RenderCRT(vTexCoord, true, uStrength);\n"
+        "    } else {\n"
+        "        outColor = RenderGBCLCD(vTexCoord, uStrength);\n"
+        "    }\n"
+        "    gl_FragColor = vec4(outColor, 1.0);\n"
+        "}\n";
+
+    const GLuint vs = compile_gl_shader(GL_VERTEX_SHADER, k_vertex_shader_src, "vertex");
+    const GLuint fs = compile_gl_shader(GL_FRAGMENT_SHADER, k_fragment_shader_src, "fragment");
+    if (!vs || !fs) {
+        if (vs) g_gl_shader.p_glDeleteShader(vs);
+        if (fs) g_gl_shader.p_glDeleteShader(fs);
+        destroy_gl_shader_pipeline();
+        return;
+    }
+
+    const GLuint prog = g_gl_shader.p_glCreateProgram();
+    if (!prog) {
+        g_gl_shader.p_glDeleteShader(vs);
+        g_gl_shader.p_glDeleteShader(fs);
+        destroy_gl_shader_pipeline();
+        return;
+    }
+    g_gl_shader.p_glAttachShader(prog, vs);
+    g_gl_shader.p_glAttachShader(prog, fs);
+    g_gl_shader.p_glLinkProgram(prog);
+    g_gl_shader.p_glDeleteShader(vs);
+    g_gl_shader.p_glDeleteShader(fs);
+
+    GLint linked = 0;
+    g_gl_shader.p_glGetProgramiv(prog, GL_LINK_STATUS, &linked);
+    if (!linked) {
+        char log_buf[1024];
+        GLsizei len = 0;
+        g_gl_shader.p_glGetProgramInfoLog(prog, (GLsizei)sizeof(log_buf) - 1, &len, log_buf);
+        log_buf[(len >= 0 && len < (GLsizei)sizeof(log_buf)) ? len : 0] = '\0';
+        fprintf(stderr, "[SDL] GLSL shader program link failed: %s\n", log_buf);
+        g_gl_shader.p_glDeleteProgram(prog);
+        destroy_gl_shader_pipeline();
+        return;
+    }
+
+    g_gl_shader.program = prog;
+    g_gl_shader.loc_texture = g_gl_shader.p_glGetUniformLocation(prog, "uTexture");
+    g_gl_shader.loc_source_size = g_gl_shader.p_glGetUniformLocation(prog, "uSourceSize");
+    g_gl_shader.loc_output_size = g_gl_shader.p_glGetUniformLocation(prog, "uOutputSize");
+    g_gl_shader.loc_texcoord_scale = g_gl_shader.p_glGetUniformLocation(prog, "uTexCoordScale");
+    g_gl_shader.loc_strength = g_gl_shader.p_glGetUniformLocation(prog, "uStrength");
+    g_gl_shader.loc_mode = g_gl_shader.p_glGetUniformLocation(prog, "uMode");
+    g_gl_shader.ready = true;
+    fprintf(stderr, "[SDL] GLSL shader pipeline ready (CRT-Lottes + GBC LCD).\n");
+}
+
+static bool render_with_gl_shader(GBScreenEffect effect) {
+    if (!g_gl_shader.ready || !g_renderer || !g_texture ||
+        g_game_viewport.w <= 0 || g_game_viewport.h <= 0) {
+        return false;
+    }
+
+#if SDL_VERSION_ATLEAST(2, 0, 10)
+    SDL_RenderFlush(g_renderer);
+#endif
+
+    int out_w = 0;
+    int out_h = 0;
+    if (SDL_GetRendererOutputSize(g_renderer, &out_w, &out_h) != 0 || out_w <= 0 || out_h <= 0) {
+        return false;
+    }
+
+    GLint prev_viewport[4] = {0, 0, out_w, out_h};
+    GLint prev_program = 0;
+    GLint prev_active_tex = GL_TEXTURE0;
+    GLint prev_tex2d = 0;
+    g_gl_shader.p_glGetIntegerv(GL_VIEWPORT, prev_viewport);
+    g_gl_shader.p_glGetIntegerv(GL_CURRENT_PROGRAM, &prev_program);
+    g_gl_shader.p_glGetIntegerv(GL_ACTIVE_TEXTURE, &prev_active_tex);
+    g_gl_shader.p_glActiveTexture(GL_TEXTURE0);
+    g_gl_shader.p_glGetIntegerv(GL_TEXTURE_BINDING_2D, &prev_tex2d);
+
+    float tex_w = 1.0f;
+    float tex_h = 1.0f;
+    if (SDL_GL_BindTexture(g_texture, &tex_w, &tex_h) != 0) {
+        g_gl_shader.p_glBindTexture(GL_TEXTURE_2D, (GLuint)prev_tex2d);
+        g_gl_shader.p_glActiveTexture((GLenum)prev_active_tex);
+        return false;
+    }
+    if (tex_w > 1.5f || tex_h > 1.5f || tex_w <= 0.0f || tex_h <= 0.0f) {
+        SDL_GL_UnbindTexture(g_texture);
+        g_gl_shader.p_glBindTexture(GL_TEXTURE_2D, (GLuint)prev_tex2d);
+        g_gl_shader.p_glActiveTexture((GLenum)prev_active_tex);
+        return false;
+    }
+
+    GLint prev_min_filter = GL_NEAREST;
+    GLint prev_mag_filter = GL_NEAREST;
+    GLint prev_wrap_s = GL_CLAMP_TO_EDGE;
+    GLint prev_wrap_t = GL_CLAMP_TO_EDGE;
+    g_gl_shader.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, &prev_min_filter);
+    g_gl_shader.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, &prev_mag_filter);
+    g_gl_shader.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, &prev_wrap_s);
+    g_gl_shader.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, &prev_wrap_t);
+
+    g_gl_shader.p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    g_gl_shader.p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    g_gl_shader.p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    g_gl_shader.p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+    g_gl_shader.p_glPushAttrib(GL_ALL_ATTRIB_BITS);
+    g_gl_shader.p_glDisable(GL_SCISSOR_TEST);
+    g_gl_shader.p_glDisable(GL_BLEND);
+    g_gl_shader.p_glDisable(GL_DEPTH_TEST);
+    g_gl_shader.p_glDisable(GL_CULL_FACE);
+
+    g_gl_shader.p_glMatrixMode(GL_PROJECTION);
+    g_gl_shader.p_glPushMatrix();
+    g_gl_shader.p_glLoadIdentity();
+    g_gl_shader.p_glMatrixMode(GL_MODELVIEW);
+    g_gl_shader.p_glPushMatrix();
+    g_gl_shader.p_glLoadIdentity();
+
+    const GLint gl_y = out_h - (g_game_viewport.y + g_game_viewport.h);
+    g_gl_shader.p_glViewport(g_game_viewport.x, gl_y, g_game_viewport.w, g_game_viewport.h);
+
+    float mode_val = 0.0f;
+    if (effect == GB_SCREEN_EFFECT_CRT_CURVED) {
+        mode_val = 1.0f;
+    } else if (effect == GB_SCREEN_EFFECT_GBC_LCD) {
+        mode_val = 2.0f;
+    }
+    const float strength = clampf((float)g_screen_effect_intensity / 100.0f, 0.0f, 1.0f);
+
+    g_gl_shader.p_glUseProgram(g_gl_shader.program);
+    if (g_gl_shader.loc_texture >= 0) {
+        g_gl_shader.p_glUniform1i(g_gl_shader.loc_texture, 0);
+    }
+    if (g_gl_shader.loc_source_size >= 0) {
+        g_gl_shader.p_glUniform2f(g_gl_shader.loc_source_size,
+                                  (float)g_present_width, (float)GB_SCREEN_HEIGHT);
+    }
+    if (g_gl_shader.loc_output_size >= 0) {
+        g_gl_shader.p_glUniform2f(g_gl_shader.loc_output_size,
+                                  (float)g_game_viewport.w, (float)g_game_viewport.h);
+    }
+    if (g_gl_shader.loc_texcoord_scale >= 0) {
+        g_gl_shader.p_glUniform2f(g_gl_shader.loc_texcoord_scale, tex_w, tex_h);
+    }
+    if (g_gl_shader.loc_strength >= 0) {
+        g_gl_shader.p_glUniform1f(g_gl_shader.loc_strength, strength);
+    }
+    if (g_gl_shader.loc_mode >= 0) {
+        g_gl_shader.p_glUniform1f(g_gl_shader.loc_mode, mode_val);
+    }
+
+    g_gl_shader.p_glBegin(GL_QUADS);
+    g_gl_shader.p_glTexCoord2f(0.0f, 1.0f);
+    g_gl_shader.p_glVertex2f(-1.0f, -1.0f);
+    g_gl_shader.p_glTexCoord2f(1.0f, 1.0f);
+    g_gl_shader.p_glVertex2f(1.0f, -1.0f);
+    g_gl_shader.p_glTexCoord2f(1.0f, 0.0f);
+    g_gl_shader.p_glVertex2f(1.0f, 1.0f);
+    g_gl_shader.p_glTexCoord2f(0.0f, 0.0f);
+    g_gl_shader.p_glVertex2f(-1.0f, 1.0f);
+    g_gl_shader.p_glEnd();
+
+    g_gl_shader.p_glUseProgram((GLuint)prev_program);
+
+    g_gl_shader.p_glMatrixMode(GL_MODELVIEW);
+    g_gl_shader.p_glPopMatrix();
+    g_gl_shader.p_glMatrixMode(GL_PROJECTION);
+    g_gl_shader.p_glPopMatrix();
