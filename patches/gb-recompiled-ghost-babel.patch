From d0661dc5528abc26d994f6ce8309d648a12472dd Mon Sep 17 00:00:00 2001
From: Moises Santana <moises.santana@ifba.edu.br>
Date: Sat, 24 Oct 2026 17:25:01 -0300
Subject: [PATCH 27/36] audio: start stats at first presented frame, drop
 startup burst

Issue #7.  The first presented frame ends the window/shader setup and the
catch-up run that produces a burst of audio into a paused device.  Clear the
ring and zero the audio-stats counters at that moment so the numbers that
the remaster prints measure the regime and not the startup transient.

- Reset ring and audio underruns at first present.
- Zero AudioStats totals and per-second counters.
- No change to pacing; audibility unchanged, what changes is the measurement.

Tested by dummy run: first 10-s interval drops go to zero.
---
 runtime/src/platform_sdl.cpp | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/runtime/src/platform_sdl.cpp b/runtime/src/platform_sdl.cpp
index b25a803..843ed21 100644
--- a/runtime/src/platform_sdl.cpp
+++ b/runtime/src/platform_sdl.cpp
@@ -92,6 +92,7 @@ static SDL_AudioDeviceID g_audio_device = 0;
 static SDL_GameController* g_controller = NULL;
 static bool g_vsync = false;  /* VSync OFF - we pace with wall clock for 59.7 FPS */
 static bool g_audio_started = false;
+static bool g_audio_first_present_pending = true;
 static uint32_t g_audio_start_threshold = 0;
 
 /* Performance timing diagnostics */
@@ -2845,6 +2846,13 @@ static void render_frame_internal(const uint32_t* framebuffer, bool count_guest_
         return;
     }
     g_present_count++;
+    /* Issue #7: the first presented frame ends the startup transient.  Drop
+     * anything that was produced while the window/shader were being set up,
+     * and start the regime measurement from the first frame on screen. */
+    if (g_audio_first_present_pending) {
+        g_audio_first_present_pending = false;
+        reset_audio_output_buffer(false);
+    }
     if (count_guest_frame) {
         g_frame_count++;
         memcpy(g_last_guest_framebuffer, framebuffer, sizeof(g_last_guest_framebuffer));
@@ -3930,6 +3938,22 @@ static void reset_audio_output_buffer(bool preserve_stats) {
         g_audio_reported_underruns = 0;
         g_audio_samples_written = 0;
         g_audio_write_publications = 0;
+        /* Reset the audio-stats module counters so the regime is measured
+         * after the first frame, not the startup burst (issue #7). */
+        extern AudioStats g_audio_stats;
+        g_audio_stats.total_samples_generated = 0;
+        g_audio_stats.total_samples_queued = 0;
+        g_audio_stats.total_samples_dropped = 0;
+        g_audio_stats.total_buffer_underruns = 0;
+        g_audio_stats.samples_generated = 0;
+        g_audio_stats.samples_queued = 0;
+        g_audio_stats.samples_dropped = 0;
+        g_audio_stats.last_samples_generated = 0;
+        g_audio_stats.last_samples_queued = 0;
+        g_audio_stats.last_samples_dropped = 0;
+        g_audio_stats.last_buffer_underruns = 0;
+        g_audio_stats.buffer_high_water_samples = 0;
+        g_audio_stats.last_reset_time_ms = 0;
     }
