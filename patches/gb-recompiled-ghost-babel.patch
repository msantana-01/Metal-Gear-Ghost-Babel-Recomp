@@ -32,6 +32,19 @@ typedef enum {
     GB_MODEL_SGB,   /**< Super GameBoy */
 } GBModel;
 
+/**
+ * @brief CGB boot-ROM revision family (affects configured post-boot state)
+ *
+ * CGB boot ROM revisions differ in how long they run, which leaves the
+ * internal DIV counter at a different value/phase at handoff. The runtime
+ * does not execute a boot ROM, so each family is represented by its own
+ * calibrated post-boot constant.
+ */
+typedef enum {
+    GB_CGB_REVISION_0 = 0,      /**< CGB boot ROM revision 0 */
+    GB_CGB_REVISION_ABCDE = 1,  /**< CGB boot ROM revisions A-E */
+} GBCGBRevision;
+
 /**
  * @brief Runtime configuration
  */
@@ -49,6 +62,7 @@ typedef struct {
     bool ignore_rtc_persistence; /**< Start the cartridge RTC clean instead of loading its .rtc file */
     bool native_presentation_enabled; /**< Allow exact-ROM native hooks to replace guest presentation */
     GBHostConfiguration host_configuration; /**< Applied host-owned gameplay configuration and path-free identity */
+    GBCGBRevision cgb_revision; /**< Post-boot CGB boot-ROM revision family (DMG-compat DIV); default GB_CGB_REVISION_0 */
 } GBConfig;
 
