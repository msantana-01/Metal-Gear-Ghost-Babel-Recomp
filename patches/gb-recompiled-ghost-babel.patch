+static float clampf(float value, float low, float high) {
+    return value < low ? low : (value > high ? high : value);
+}
+
+static float smooth_ramp(float t) {
+    const float v = clampf(t, 0.0f, 1.0f);
+    return v * v * (3.0f - 2.0f * v);
+}
+
+/* Antialiased coverage of the band [lo,hi] at position t: a trapezoid that
+ * ramps over `soft` at each end and stops at `hi`. The stopping is the point -
+ * a ramp centred on the edge bleeds `soft` past it, and two bleeding edges
+ * widen a 0.22 pixel gap into nearly 0.4, which is the difference between an
+ * LCD panel and a dot matrix. */
+static float band_coverage(float t, float lo, float hi, float soft) {
+    if (hi <= lo || soft <= 0.0f) {
+        return 0.0f;
+    }
+    return smooth_ramp((t - lo) / soft) * smooth_ramp((hi - t) / soft);
+}
