@@ -0,0 +1,238 @@
+/* Measure what the audio mastering chain claims about itself.
+ *
+ * The chain makes four claims and none of them is about taste: the DC offset is
+ * gone, peaks are rounded rather than clipped, loud passages are eased down
+ * while quiet ones are left alone, and the hardware's channel panning survives.
+ * A pair of ears cannot measure any of those, and "it compiles" is not evidence
+ * that a feedback filter stays stable - a DC blocker with the wrong sign goes to
+ * infinity and sounds like a pop, not like a filter. So the chain is driven from
+ * here over signals chosen to break it.
+ *
+ * Run:
+ *   cmake -G Ninja -B build . -DBUILD_TESTS=ON && ninja -C build
+ *   ctest --test-dir build -R audio_mastering --output-on-failure
+ */
+
+#include "platform_sdl.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+
+namespace {
+
+int failures = 0;
+
+void check(bool condition, const char* what) {
+    if (!condition) {
+        std::printf("FAIL %s\n", what);
+        failures++;
+    }
+}
+
+void check_near(double got, double want, double tolerance, const char* what) {
+    const double delta = std::fabs(got - want);
+    if (!(delta <= tolerance)) {
+        std::printf("FAIL %s: got %.6f, want %.6f +/- %.6f\n", what, got, want, tolerance);
+        failures++;
+    }
+}
+
+constexpr uint32_t kBlock = 512;
+
+/* The DC blocker is a one-pole high-pass with a corner near 3.5Hz, which is a
+ * time constant of roughly 45ms - about 2000 samples. It cancels a bias, but it
+ * cancels it over that time and not instantly, so testing it on a single
+ * 512-frame block measures the filter's settling rather than its result. These
+ * tests use a block long enough for the bias to be gone, and say why. */
+constexpr uint32_t kLongBlock = 16384;
+
+/* Mean of the left channel over the settled tail, which is where a filter's
+ * result lives and where its transient does not. */
+double tail_mean(const std::vector<int16_t>& frames, uint32_t block_frames,
+                 uint32_t tail_frames) {
+    double total = 0.0;
+    for (uint32_t f = block_frames - tail_frames; f < block_frames; ++f) {
+        total += (double)frames[f * 2];
+    }
+    return total / (double)tail_frames;
+}
+
+int32_t peak(const std::vector<int16_t>& frames) {
+    int32_t highest = 0;
+    for (int16_t sample : frames) {
+        const int32_t magnitude = sample < 0 ? -(int32_t)sample : (int32_t)sample;
+        if (magnitude > highest) highest = magnitude;
+    }
+    return highest;
+}
+
+/* The DC blocker's job is a bias sitting on the signal. A constant offset with
+ * no signal in it is the cleanest possible probe: the whole thing must go. */
+void dc_offset_is_removed() {
+    gb_platform_test_audio_master_reset();
+    std::vector<int16_t> frames(kLongBlock * 2, 4000);
+    gb_platform_test_audio_master_block(frames.data(), kLongBlock, 1.0f);
+    /* The settled tail, not the whole block. The filter's time constant is
+     * about 2000 samples, so the block opens with a step response that decays
+     * across it - and the mean of a decaying exponential is dominated by
+     * exactly that opening, not by how the filter ends up. Averaging the whole
+     * block measures the transient and calls it the result. */
+    check_near(tail_mean(frames, kLongBlock, 512), 0.0, 20.0,
+               "a constant DC offset is cancelled");
+
+    /* The harder case is an offset riding on a signal, because a filter that
+     * merely fades a constant to zero has not removed anything. The pulse pair
+     * the Game Boy produces is a square wave, so a square wave with a bias is
+     * what the chain actually sees. */
+    gb_platform_test_audio_master_reset();
+    std::vector<int16_t> biased(kLongBlock * 2);
+    for (uint32_t i = 0; i < kLongBlock; ++i) {
+        const int16_t square = ((i / 32) % 2) ? 12000 : -12000;
+        biased[i * 2] = (int16_t)(square + 4000);
+        biased[i * 2 + 1] = (int16_t)(square + 4000);
+    }
+    gb_platform_test_audio_master_block(biased.data(), kLongBlock, 1.0f);
+    check_near(tail_mean(biased, kLongBlock, 512), 0.0, 600.0,
+               "a DC bias riding on a signal is cancelled");
+}
+
+/* Peaks must arrive rounded. A sample sitting exactly on 32767 is a hard clip
+ * and is audible as fizz; the chain's whole claim is that it does not do that. */
+void peaks_are_rounded_not_clipped() {
+    gb_platform_test_audio_master_reset();
+    std::vector<int16_t> full(kBlock * 2);
+    for (uint32_t i = 0; i < kBlock; ++i) {
+        full[i * 2] = ((i / 16) % 2) ? 32767 : -32767;
+        full[i * 2 + 1] = full[i * 2];
+    }
+    gb_platform_test_audio_master_block(full.data(), kBlock, 1.0f);
+
+    int32_t saturated = 0;
+    for (int16_t sample : full) {
+        if (sample == 32767 || sample == -32768) saturated++;
+    }
+    check(saturated == 0, "no sample is pinned to full scale after soft clipping");
+
+    /* And the curve must stay inside the input's range: a saturation curve that
+     * overshoots is a distortion generator wearing a limiter's name. */
+    int32_t worst = 0;
+    for (int16_t sample : full) {
+        const int32_t magnitude = sample < 0 ? -(int32_t)sample : (int32_t)sample;
+        if (magnitude > worst) worst = magnitude;
+    }
+    check(worst <= 32767, "the soft clip never exceeds full scale");
+}
+
+/* Gentle means the quiet part of the music is not the casualty. A compressor
+ * that squares off everything is not mastering, it is one more distortion. */
+void quiet_material_is_left_alone() {
+    gb_platform_test_audio_master_reset();
+    std::vector<int16_t> quiet(kBlock * 2);
+    for (uint32_t i = 0; i < kBlock; ++i) {
+        /* -34 dBFS: far below the -12 dBFS threshold. */
+        const double phase = (double)i / 40.0;
+        const int16_t value = (int16_t)(1500.0 * std::sin(phase));
+        quiet[i * 2] = value;
+        quiet[i * 2 + 1] = value;
+    }
+    const int32_t before = peak(quiet);
+    gb_platform_test_audio_master_block(quiet.data(), kBlock, 1.0f);
+    const int32_t after = peak(quiet);
+    check_near((double)after, (double)before, (double)before * 0.05,
+               "material well under the threshold passes through unchanged");
+}
+
+/* And the loud part is the part that moves. Without this the "gentle" test above
+ * would be satisfied by a chain that does nothing at all. */
+void loud_material_is_eased_down() {
+    gb_platform_test_audio_master_reset();
+    std::vector<int16_t> loud(kBlock * 2);
+    for (uint32_t i = 0; i < kBlock; ++i) {
+        loud[i * 2] = ((i / 16) % 2) ? 30000 : -30000;
+        loud[i * 2 + 1] = loud[i * 2];
+    }
+    gb_platform_test_audio_master_block(loud.data(), kBlock, 1.0f);
+    check(peak(loud) < 30000, "material above the threshold comes out quieter");
+}
+
+/* The Game Boy's channels are panned by the APU, not by this chain. Compressing
+ * the two sides independently would move the stereo image every time one side
+ * got quieter - the pulse channels are hard panned, so the image is a fixed
+ * fact of the hardware and must survive. */
+void channel_panning_survives() {
+    gb_platform_test_audio_master_reset();
+    std::vector<int16_t> panned(kBlock * 2);
+    for (uint32_t i = 0; i < kBlock; ++i) {
+        const int16_t square = ((i / 16) % 2) ? 30000 : -30000;
+        panned[i * 2] = square;
+        panned[i * 2 + 1] = (int16_t)-square;
+    }
+    gb_platform_test_audio_master_block(panned.data(), kBlock, 1.0f);
+
+    int32_t worst_asymmetry = 0;
+    for (uint32_t i = 0; i < kBlock; ++i) {
+        const int32_t left = panned[i * 2] < 0 ? -(int32_t)panned[i * 2] : (int32_t)panned[i * 2];
+        const int32_t right =
+            panned[i * 2 + 1] < 0 ? -(int32_t)panned[i * 2 + 1] : (int32_t)panned[i * 2 + 1];
+        const int32_t asymmetry = left - right;
+        if (asymmetry < 0 ? -asymmetry : asymmetry > worst_asymmetry) {
+            worst_asymmetry = asymmetry < 0 ? -asymmetry : asymmetry;
+        }
+    }
+    check(worst_asymmetry == 0, "a hard-panned pair stays hard panned");
+}
+
+/* The chain filters, so it carries state. Run twice from the same state on the
+ * same input and get the same answer - and make sure the test itself is not
+ * depending on a previous case having run. */
+void the_chain_is_deterministic() {
+    gb_platform_test_audio_master_reset();
+    std::vector<int16_t> first(kBlock * 2);
+    for (uint32_t i = 0; i < kBlock; ++i) {
+        const int16_t square = ((i / 8) % 2) ? 28000 : -28000;
+        first[i * 2] = square;
+        first[i * 2 + 1] = (int16_t)(square / 3);
+    }
+    gb_platform_test_audio_master_block(first.data(), kBlock, 1.0f);
+
+    gb_platform_test_audio_master_reset();
+    std::vector<int16_t> second = first;
+    /* Put the original signal back and run it again. */
+    for (uint32_t i = 0; i < kBlock; ++i) {
+        const int16_t square = ((i / 8) % 2) ? 28000 : -28000;
+        second[i * 2] = square;
+        second[i * 2 + 1] = (int16_t)(square / 3);
+    }
+    gb_platform_test_audio_master_block(second.data(), kBlock, 1.0f);
+
+    check(first == second, "the same signal from the same state gives the same output");
+
+    /* And a long run must not drift: the filter is a feedback loop, so the
+     * failure mode of getting it wrong is divergence, not a wrong constant. */
+    gb_platform_test_audio_master_reset();
+    std::vector<int16_t> long_run(4096 * 2);
+    for (uint32_t i = 0; i < 4096; ++i) {
+        long_run[i * 2] = 20000;
+        long_run[i * 2 + 1] = -20000;
+    }
+    gb_platform_test_audio_master_block(long_run.data(), 4096, 1.0f);
+    check(peak(long_run) <= 32767, "a long constant input does not make the filter diverge");
+}
+
+}  // namespace
+
+int main() {
+    dc_offset_is_removed();
+    peaks_are_rounded_not_clipped();
+    quiet_material_is_left_alone();
+    loud_material_is_eased_down();
+    channel_panning_survives();
+    the_chain_is_deterministic();
+
+    if (failures == 0) {
+        std::printf("audio mastering: every claim holds\n");
+    }
+    return failures == 0 ? 0 : 1;
+}
\ No newline at end of file
