--- a/tests/test_lcd_response.cpp
+++ b/tests/test_lcd_response.cpp
@@ -14,6 +14,10 @@ static uint32_t argb(uint32_t r, uint32_t g, uint32_t b) {
     return 0xFF000000u | (r << 16) | (g << 8) | b;
 }
 static uint32_t red_of(uint32_t v) { return (v >> 16) & 0xFFu; }
+static double to_linear(uint32_t channel_byte) {
+    const double c = (double)channel_byte / 255.0;
+    return (c <= 0.04045) ? (c / 12.92) : std::pow((c + 0.055) / 1.055, 2.4);
