+            /* Post-boot DIV for DMG-compat on CGB, per boot-ROM revision
+             * family (mooneye misc/boot_div-*.s: both tests share the read
+             * cadence and expect the DMG sequence shifted by the boot-ROM
+             * handoff delta):
+             *   revision 0 (nops 24): DMG 0xABCC - 0x83*256 - 72 T  = 0x2884
+             *     -> verified reads 29 2A 2A 2B 2C 2E (boot_div-cgb0)
+             *   revisions A-E (nops 27): DMG 0xABCC - 0x85*256 - 84 T = 0x2678
+             *     -> verified reads 27 28 28 29 2A 2C (boot_div-cgbABCDE)
+             * The T-cycle terms are the first-read delay versus the DMG
+             * test's nops 6. The two families are mutually exclusive on
+             * real hardware, so --model cgb0 / cgb-abcde selects one. */
+            if (ctx->config.cgb_revision == GB_CGB_REVISION_ABCDE) {
+                ctx->div_counter = 0x2678;
+            } else {
+                ctx->div_counter = 0x2884;
+            }
         } else {
             ctx->af = 0x01B0;
             ctx->bc = 0x0013;
@@ -2696,6 +2711,7 @@ static uint8_t gbrt_read8_impl(GBContext* ctx,
             return res;
         }
         if (addr == 0xFF04) return (uint8_t)(ctx->div_counter >> 8);
+        if (addr == 0xFF07) return (uint8_t)(ctx->io[0x07] | 0xF8);
         if (addr == 0xFF0F) return (uint8_t)(0xE0 | (ctx->io[0x0F] & 0x1F));
         if (addr == 0xFF4D) {
             if (!gb_is_cgb_mode(ctx)) return 0xFF;
@@ -2753,6 +2769,11 @@ static uint8_t gbrt_read8_impl(GBContext* ctx,
             return ppu_read_register((GBPPU*)ctx->ppu, addr);
         }
         if (addr >= 0xFF68 && addr <= 0xFF6B) {
+            /* BGPI/OBPI/BGPD/OBPD: CGB hardware only; palette data reads are
+             * also CGB-mode only (SameBoy: a CGB in DMG mode can access BGPI
+             * and OBPI, but not BGPD and OBPD). */
+            if (!gb_is_cgb_hardware(ctx)) return 0xFF;
+            if ((addr == 0xFF69 || addr == 0xFF6B) && !gb_is_cgb_mode(ctx)) return 0xFF;
             gb_sync(ctx);
             return ppu_read_register((GBPPU*)ctx->ppu, addr);
         }
@@ -2760,6 +2781,25 @@ static uint8_t gbrt_read8_impl(GBContext* ctx,
             gbrt_audio_sync(ctx);
             return gb_audio_read(ctx, addr);
         }
+        switch (addr) {
+            case 0xFF03:
+            case 0xFF08: case 0xFF09: case 0xFF0A: case 0xFF0B:
+            case 0xFF0C: case 0xFF0D: case 0xFF0E:
+            case 0xFF4C: case 0xFF4E: case 0xFF50:
+            case 0xFF57: case 0xFF58: case 0xFF59: case 0xFF5A:
+            case 0xFF5B: case 0xFF5C: case 0xFF5D: case 0xFF5E:
+            case 0xFF5F: case 0xFF60: case 0xFF61: case 0xFF62:
+            case 0xFF63: case 0xFF64: case 0xFF65: case 0xFF66:
+            case 0xFF67:
+            case 0xFF6D: case 0xFF6E: case 0xFF6F:
+            case 0xFF71:
+            case 0xFF78: case 0xFF79: case 0xFF7A: case 0xFF7B:
+            case 0xFF7C: case 0xFF7D: case 0xFF7E: case 0xFF7F:
+                /* Unused IO reads as open bus (all 1s). */
+                return 0xFF;
+            default:
+                break;
+        }
         return ctx->io[addr - 0xFF00];
     }
     if (addr < 0xFFFF) return ctx->hram[addr - 0xFF80];
@@ -2998,7 +3038,8 @@ static void gbrt_write8_impl(GBContext* ctx,
         }
         if (addr == 0xFF02) {
             uint8_t sc = (uint8_t)(0x7C | (value & 0x83));
-            if (!gb_is_cgb_hardware(ctx)) {
+            if (!gb_is_cgb_mode(ctx)) {
+                /* DMG and DMG-compat always present bit 1 set. */
