index 0000000..97c9335
--- /dev/null
+++ b/tests/test_screen_effect.cpp
@@ -0,0 +1,179 @@
+#include "gbrt.h"
+#include "platform_sdl.h"
+#include "ppu.h"
+
+#include <array>
+#include <vector>
+#include <cmath>
+#include <cstdio>
+
+/* The runtime sizes the mask to the on-screen scale, so the tests walk the same
+ * range of lattices it can pick rather than one fixed one. */
+static constexpr int MIN_LATTICE = 4;
+static constexpr int MAX_LATTICE = 12;
+static constexpr int CELL = 5; /* an 800x720 window: the default */
+static constexpr int W = GB_SCREEN_WIDTH * CELL;
+static constexpr int H = GB_SCREEN_HEIGHT * CELL;
+
+static int g_effect_off = 0;
+static int g_effect_scanlines = 1;
+static int g_effect_lcd_grid = 2;
+
+static uint32_t level_of(uint32_t argb) { return (argb >> 16) & 0xFF; }
+
+static void render(std::array<uint32_t, W * H>& out, int effect, int intensity,
+                   float scale) {
+    gb_platform_test_compute_screen_effect_overlay(out.data(), W, H, effect, intensity,
+                                                   scale);
+}
+
+static bool all_white(const std::array<uint32_t, W * H>& buf) {
+    for (uint32_t v : buf) {
+        if (v != 0xFFFFFFFFu) return false;
+    }
+    return true;
+}
+
+/* Mean level across the whole mask. Measured over everything rather than one
+ * row, because what "the effect is too weak" means is how much of the image
+ * the mask darkens overall. */
+static double mean_level(const std::array<uint32_t, W * H>& buf) {
+    double total = 0.0;
+    for (uint32_t v : buf) {
+        total += (double)level_of(v);
+    }
+    return total / (double)buf.size();
+}
+
+static int fail(const char* what) {
+    std::fprintf(stderr, "FAIL: %s\n", what);
+    return 1;
+}
+
+int main() {
+    std::array<uint32_t, W * H> buf;
+
+    /* 1. Off is the identity, whatever the settings around it say. */
+    for (int intensity = 10; intensity <= 100; intensity += 10) {
+        for (float scale : {1.0f, 3.0f, 15.0f}) {
+            render(buf, g_effect_off, intensity, scale);
+            if (!all_white(buf)) return fail("Off must not darken anything");
+        }
+    }
+
+    /* 2. Zero strength is also the identity, for both real effects. */
+    for (int effect : {g_effect_scanlines, g_effect_lcd_grid}) {
+        render(buf, effect, 0, 3.0f);
+        if (!all_white(buf)) return fail("zero strength must not darken anything");
+        render(buf, effect, 0, 15.0f);
+        if (!all_white(buf)) return fail("zero strength must not darken at 15x");
+    }
+
+    /* 3. At 1x there is no room for a gap, so the effect must fade out rather
+     *    than turn the screen into mud. */
+    for (int effect : {g_effect_scanlines, g_effect_lcd_grid}) {
+        render(buf, effect, 100, 1.0f);
+        if (!all_white(buf)) return fail("must fade out at 1x, not darken");
+    }
+
+    /* 4. Alpha is opaque everywhere: the mask is composited with
+     *    SDL_BLENDMODE_MUL, which needs the colour channels and ignores alpha. */
+    render(buf, g_effect_lcd_grid, 100, 3.0f);
+    for (uint32_t v : buf) {
+        if (((v >> 24) & 0xFF) != 0xFF) return fail("mask must be opaque");
+    }
+
+    /* 5. The mask repeats on the guest-pixel lattice, which is what makes it
+     *    line up with the guest once SDL scales it. */
+    render(buf, g_effect_lcd_grid, 100, 3.0f);
+    for (int y = 0; y < H; ++y) {
+        for (int x = 0; x < W; ++x) {
+            if (buf[y * W + x] != buf[(y % CELL) * W + (x % CELL)]) {
+                return fail("mask must repeat with the guest-pixel period");
+            }
+        }
+    }
+
+    /* 5b. Every lattice the runtime can pick has to render a gap that is
+     *     actually visible. This is the failure that a fixed-width ramp
+     *     produces at the low end: the ramp takes the whole band, there is no
+     *     plateau left, peak coverage collapses, and the grid renders as
+     *     nothing at all rather than as a weak grid. */
+    for (int lattice = MIN_LATTICE; lattice <= MAX_LATTICE; ++lattice) {
+        const int w = GB_SCREEN_WIDTH * lattice;
+        const int h = GB_SCREEN_HEIGHT * lattice;
+        std::vector<uint32_t> wide((size_t)w * (size_t)h);
+        for (int effect : {g_effect_scanlines, g_effect_lcd_grid}) {
+            gb_platform_test_compute_screen_effect_overlay(wide.data(), w, h, effect, 100,
+                                                           (float)lattice);
+            unsigned darkest = 255;
+            for (size_t i = 0; i < wide.size(); ++i) {
+                const unsigned level = level_of(wide[i]);
+                if (level < darkest) darkest = level;
+            }
+            if (darkest > 80) {
+                std::fprintf(stderr,
+                             "FAIL: lattice %d effect %d too weak, darkest %u\n",
+                             lattice, effect, darkest);
+                return 1;
+            }
+        }
+    }
+
+    /* 6. Scanlines vary down the screen and are constant across it; the grid
+     *    varies on both axes. That difference is the whole point of having two
+     *    entries rather than one. Both repeat with the guest-pixel period, so
+     *    the way to see it is within one cell: the three sub-columns of a single
+     *    guest pixel. */
+    render(buf, g_effect_scanlines, 100, 3.0f);
+    for (int y = 0; y < H; ++y) {
+        if (buf[y * W] != buf[y * W + 1] || buf[y * W] != buf[y * W + 2]) {
+            return fail("scanlines must be constant across the screen");
+        }
+    }
+    render(buf, g_effect_lcd_grid, 100, 3.0f);
+    bool grid_varies_across = false;
+    bool grid_varies_down = false;
+    for (int y = 0; y < H; ++y) {
+        if (buf[y * W] != buf[y * W + 1] || buf[y * W] != buf[y * W + 2]) {
+            grid_varies_across = true;
+        }
+    }
+    for (int x = 0; x < GB_SCREEN_WIDTH * CELL; ++x) {
+        if (buf[x] != buf[W + x] || buf[x] != buf[2 * W + x]) {
+            grid_varies_down = true;
+        }
+    }
+    if (!grid_varies_across) return fail("LCD grid must vary across the screen");
+    if (!grid_varies_down) return fail("LCD grid must vary down the screen");
+
+    /* 7. The requirement this whole design exists for: one setting has to hold
+     *    up at 480p and at 4K. A fixed fraction of a guest pixel is 0.66
+     *    screen pixels at 3x and 3.3 at 15x, so the 3x gap is widened to stay
+     *    at least one screen pixel. The consequence, measured here: the mask is
+     *    *darker* at 480p than at 4K rather than fading away there. */
+    render(buf, g_effect_scanlines, 100, 3.0f);
+    const double at_480p = mean_level(buf);
+    render(buf, g_effect_scanlines, 100, 15.0f);
+    const double at_4k = mean_level(buf);
+    if (!(at_480p < at_4k)) {
+        std::fprintf(stderr, "FAIL: 480p mean %.2f should be darker than 4K mean %.2f\n",
+                     at_480p, at_4k);
+        return 1;
+    }
+    /* And it must still be a real effect at 480p, not a barely-there tint. */
+    if (at_480p > 200.0) {
+        std::fprintf(stderr, "FAIL: 480p effect too weak, mean %.2f\n", at_480p);
+        return 1;
+    }
+
+    /* 8. Strength is monotonic: more percent never means brighter. */
+    render(buf, g_effect_lcd_grid, 50, 3.0f);
+    const double weak = mean_level(buf);
+    render(buf, g_effect_lcd_grid, 100, 3.0f);
+    const double strong = mean_level(buf);
+    if (!(strong < weak)) return fail("more strength must be darker");
+
+    std::printf("screen effect: ok (480p mean %.1f, 4K mean %.1f)\n", at_480p, at_4k);
+    return 0;
+}
