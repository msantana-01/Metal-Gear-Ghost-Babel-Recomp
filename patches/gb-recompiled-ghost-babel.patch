+typedef enum {
+    GB_CGB_REVISION_0 = 0,      /**< CGB boot ROM revision 0 */
+    GB_CGB_REVISION_ABCDE = 1,  /**< CGB boot ROM revisions A-E */
+} GBCGBRevision;
