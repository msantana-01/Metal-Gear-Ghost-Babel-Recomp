diff --git a/tests/test_phosphor_glow.cpp b/tests/test_phosphor_glow.cpp
new file mode 100644
index 0000000..8379338
--- /dev/null
+++ b/tests/test_phosphor_glow.cpp
@@ -0,0 +1,101 @@
+#include "gbrt.h"
+#include "platform_sdl.h"
+
+#include <cstdio>
+#include <cstdint>
+#include <vector>
+#include <algorithm>
+
+/* The phosphor glow. One property matters more than the rest: a flat bright
+ * region must not come back brighter than it went in. Normalising a blur by the
+ * peak of its kernel instead of its sum makes an isolated pixel look right and
+ * silently multiplies every uniform area by the square of the kernel sum, which
+ * blows the whole screen to white. That is invisible in a unit test that only
+ * looks at a single hot pixel, and obvious the moment a menu is on screen. */
+
+static uint32_t argb(uint32_t v) { return 0xFF000000u | v; }
+static uint32_t grey_of(uint32_t v) { return v & 0xFFu; }
+
+static void glow(const std::vector<uint32_t>& src, std::vector<uint32_t>& dst,
+                 int w, int h, int threshold, int amount) {
+    std::vector<uint32_t> scratch((size_t)w * (size_t)h, 0);
+    dst.assign((size_t)w * (size_t)h, 0);
+    gb_platform_test_compute_phosphor_glow(src.data(), w * 4, dst.data(), scratch.data(),
+                                           w, h, threshold, amount);
+}
+
+static int fail(const char* what) {
+    std::fprintf(stderr, "FAIL: %s\n", what);
+    return 1;
+}
+
+int main() {
+    const int W = 24, H = 24;
+    std::vector<uint32_t> flat((size_t)W * H, argb(0));
+    std::vector<uint32_t> out;
+
+    /* 1. A flat bright field must produce exactly its excess over the threshold and
+     *    no more. This is the assertion that catches a peak-normalised kernel,
+     *    which returns several times the excess on any flat area. The output is
+     *    the glow contribution, not the composited colour: the blend is additive
+     *    and happens later. */
+    for (uint32_t v : {200u, 230u, 255u}) {
+        std::fill(flat.begin(), flat.end(), argb(v));
+        glow(flat, out, W, H, 128, 100);
+        const uint32_t expected = v - 128u;
+        const uint32_t got = grey_of(out.front());
+        if (got != expected) {
+            std::fprintf(stderr, "FAIL: flat %u should glow %u, got %u\n", v, expected,
+                         got);
+            return 1;
+        }
+    }
+
+    /* 2. A dark field must stay dark: nothing to bleed, nothing to add. */
+    std::fill(flat.begin(), flat.end(), argb(20));
+    glow(flat, out, W, H, 128, 100);
+    for (uint32_t v : out) {
+        if (grey_of(v) != 0) return fail("a dark field must produce no glow");
+    }
+
+    /* 3. Below the threshold, even a bright pixel still contributes nothing. */
+    std::fill(flat.begin(), flat.end(), argb(0));
+    flat[(size_t)(H / 2) * W + (W / 2)] = argb(120);
+    glow(flat, out, W, H, 128, 100);
+    for (uint32_t v : out) {
+        if (grey_of(v) != 0) return fail("below-threshold pixels must not bloom");
+    }
+
+    /* 4. Above it, a single hot pixel must produce a halo that falls off with
+     *    distance - the actual shape of a phosphor bleed. */
+    std::fill(flat.begin(), flat.end(), argb(0));
+    flat[(size_t)(H / 2) * W + (W / 2)] = argb(255);
+    glow(flat, out, W, H, 128, 100);
+
+    const size_t centre = (size_t)(H / 2) * W + (W / 2);
+    const uint32_t at_centre = grey_of(out[centre]);
+    const uint32_t at_one = grey_of(out[centre + 1]);
+    const uint32_t at_far = grey_of(out[centre + 8]);
+    if (at_centre == 0) return fail("a hot pixel must glow");
+    if (!(at_one > 0 && at_one < at_centre)) {
+        std::fprintf(stderr, "FAIL: halo not falling off (%u, %u, %u)\n", at_centre,
+                     at_one, at_far);
+        return 1;
+    }
+    if (!(at_far < at_one)) return fail("the halo must keep falling off");
+
+    /* 5. Strength has to do something, in the right direction, with no blowout
+     *    even at the top of the slider. */
+    glow(flat, out, W, H, 128, 20);
+    const uint32_t weak = grey_of(out[centre]);
+    glow(flat, out, W, H, 128, 100);
+    const uint32_t strong = grey_of(out[centre]);
+    if (!(strong > weak)) return fail("more strength must mean more glow");
+    if (strong > 80) {
+        std::fprintf(stderr, "FAIL: glow at full strength is %u, too hot\n", strong);
+        return 1;
+    }
+
+    std::printf("phosphor glow: ok (centre %u at 20, %u at 100)\n", weak, strong);
+    return 0;
+}
