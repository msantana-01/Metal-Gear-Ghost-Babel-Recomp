+ * effect.
+ *
+ * The mask is rasterised at `lattice` mask pixels per guest pixel, where the
+ * caller passes the on-screen scale factor. That coupling is the whole design:
+ * a gap of a fifth of a guest pixel is barely one screen pixel at 480p and
+ * several at 4K, so a mask on a fixed guest multiple either snaps the gap to
+ * whole sub-columns (and the grid reads as a dot matrix) or blurs it. Rasterised
+ * at the destination, one mask pixel is one screen pixel and the gap comes out
+ * the width it was asked for at every window size. dst_w must be an exact
+ * multiple of GB_SCREEN_WIDTH.
+ *
+ * scale_factor is that same on-screen scale, kept separate because the gap also
+ * has to survive the low end: 0.22 guest pixels is 0.66 screen pixels at 480p
+ * (3x), which aliases into shimmering noise rather than reading as a line.
+ * Holding the gap to at least one screen pixel is what lets one setting hold up
+ * at both ends, and it is why the effect stays visible at 480p instead of
+ * fading out there.
+ */
+static void compute_screen_effect_overlay(uint32_t* dst, int dst_w, int dst_h,
+                                          int effect, int intensity_percent,
+                                          float scale_factor) {
+    const float amount = clampf((float)intensity_percent / 100.0f, 0.0f, 1.0f);
+    /* Below 2x there is no room for a gap that reads as a line instead of as
+     * shading, so the effect fades out rather than turning the screen muddy. */
+    const float usable = clampf(scale_factor - 1.0f, 0.0f, 1.0f);
+    const float strength = amount * usable;
+
+    const float one_screen_pixel = (scale_factor > 1.0f) ? (1.0f / scale_factor) : 1.0f;
+    const float gap = clampf(fmaxf(GB_SCREEN_EFFECT_GAP_GUEST,
+                                   GB_SCREEN_EFFECT_MIN_GAP_SCREEN * one_screen_pixel),
+                             0.0f, GB_SCREEN_EFFECT_MAX_GAP_GUEST);
