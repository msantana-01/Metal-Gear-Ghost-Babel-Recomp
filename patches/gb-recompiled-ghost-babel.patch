 runtime/include/gbrt_presentation.h | 11 ++++++++++-
 runtime/src/gbrt_presentation.c     |  7 +++++++
 runtime/src/ppu.c                   |  9 ++++++++-
 4 files changed, 37 insertions(+), 2 deletions(-)

diff --git a/runtime/include/gbrt.h b/runtime/include/gbrt.h
index c44f8f9..d78a70c 100644
--- a/runtime/include/gbrt.h
+++ b/runtime/include/gbrt.h
@@ -422,6 +422,18 @@ typedef struct GBContext {
     
     /* Hardware components (opaque pointers) */
     void* ppu;            /**< Pixel Processing Unit */
+    /* LCDC as it stood when each visible scanline began its dot transfer, in
+     * LY order (GB_SCREEN_HEIGHT entries; ppu.h owns that constant and cannot
+     * be included here). The guest may rewrite LCDC between lines - Ghost Babel
+     * selects the second background map for its bottom HUD band and restores
+     * the register at vblank - so the register alone describes only the rows
+     * that were still drawing when the frame ended. A row that switched maps
+     * during its dot transfer is recorded with the value it started with.
+     *
+     * Per-frame telemetry, not state: the savestate carries the PPU struct and
+     * deliberately not this, so states written before this record existed still
+     * load, and a state that omits it costs one frame of the record. */
+    uint8_t ppu_scanline_lcdc[144];
     void* apu;            /**< Audio Processing Unit */
     void* timer;          /**< Timer unit */
     void* serial;         /**< Serial port */
diff --git a/runtime/include/gbrt_presentation.h b/runtime/include/gbrt_presentation.h
index ea3d6d4..f4f20cf 100644
--- a/runtime/include/gbrt_presentation.h
