+        switch (addr) {
+            case 0xFF03:
+            case 0xFF08: case 0xFF09: case 0xFF0A: case 0xFF0B:
+            case 0xFF0C: case 0xFF0D: case 0xFF0E:
+            case 0xFF4C: case 0xFF4E: case 0xFF50:
+            case 0xFF57: case 0xFF58: case 0xFF59: case 0xFF5A:
+            case 0xFF5B: case 0xFF5C: case 0xFF5D: case 0xFF5E:
