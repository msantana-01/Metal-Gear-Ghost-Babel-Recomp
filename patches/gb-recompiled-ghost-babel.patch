diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index ffb4972..64bae97 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -448,6 +448,10 @@ if(TARGET gbrt)
     target_link_libraries(test_ppu_dot_timing PRIVATE gbrt)
     add_test(NAME ppu_uses_dot_aware_pixel_transfer COMMAND test_ppu_dot_timing)
 
+    add_executable(test_ppu_scanline_lcdc test_ppu_scanline_lcdc.c)
+    target_link_libraries(test_ppu_scanline_lcdc PRIVATE gbrt)
+    add_test(NAME ppu_records_lcdc_per_scanline COMMAND test_ppu_scanline_lcdc)
+
     add_executable(test_runtime_bus_phase test_runtime_bus_phase.c)
     target_link_libraries(test_runtime_bus_phase PRIVATE gbrt)
     add_test(NAME ram_stub_places_memory_access_in_final_mcycle COMMAND test_runtime_bus_phase)
diff --git a/tests/test_ppu_scanline_lcdc.c b/tests/test_ppu_scanline_lcdc.c
new file mode 100644
index 0000000..b7010cb
--- /dev/null
+++ b/tests/test_ppu_scanline_lcdc.c
@@ -0,0 +1,135 @@
+/* The presentation ABI exports LCDC per visible scanline because a guest may
+ * change background maps between rows. Ghost Babel does: it selects the second
+ * map for the bottom HUD band and restores the register at vblank, so the
+ * register alone describes only the rows that were still drawing when the frame
+ * ended and the band is invisible to a frontend that samples it once per frame.
+ *
+ * This drives real PPU dots through a frame, switches the map the way the game
+ * does, and checks what each row recorded. */
+
+#include "gbrt.h"
+#include "ppu.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#define FRAME_CYCLES 70224u
+
+static GBContext* make_context(void) {
+    GBConfig config;
+    memset(&config, 0, sizeof(config));
+    config.model = GB_MODEL_DMG;
+
+    GBContext* ctx = gb_context_create(&config);
+    if (!ctx) {
+        return NULL;
+    }
+
+    uint8_t rom[32u * 1024u];
+    memset(rom, 0, sizeof(rom));
+    if (!gb_context_load_rom(ctx, rom, sizeof(rom))) {
+        gb_context_destroy(ctx);
+        return NULL;
+    }
+    gb_context_reset(ctx, true);
+    memset(ctx->oam, 0, OAM_SIZE);
+    memset(ctx->vram, 0, VRAM_SIZE * 2u);
+    return ctx;
+}
+
+/* One frame of dots. The register is switched at LY=3 and restored at LY=144,
+ * which is where a band that owns the bottom rows would do it. */
+static void run_switching_frame(GBContext* ctx, uint8_t scene, uint8_t band) {
+    GBPPU* ppu = (GBPPU*)ctx->ppu;
+    ppu_write_register(ppu, ctx, 0xFF40, scene);
+    for (uint32_t cycle = 0; cycle < FRAME_CYCLES; ++cycle) {
+        if (ppu->ly == 3u && ppu->mode != PPU_MODE_VBLANK && ppu->lcdc == scene) {
+            ppu_write_register(ppu, ctx, 0xFF40, band);
+        } else if (ppu->ly == 144u && ppu->lcdc == band) {
+            ppu_write_register(ppu, ctx, 0xFF40, scene);
+        }
+        ppu_tick(ppu, ctx, 1u);
+    }
+}
+
+static void run_quiet_frame(GBContext* ctx, uint8_t lcdc) {
+    GBPPU* ppu = (GBPPU*)ctx->ppu;
+    ppu_write_register(ppu, ctx, 0xFF40, lcdc);
+    for (uint32_t cycle = 0; cycle < FRAME_CYCLES; ++cycle) {
+        ppu_tick(ppu, ctx, 1u);
+    }
+}
+
+int main(void) {
+    GBContext* ctx = make_context();
+    if (!ctx) {
+        fprintf(stderr, "scanline LCDC: could not build a context\n");
+        return 1;
+    }
+
+    const uint8_t scene =
+        LCDC_LCD_ENABLE | LCDC_BG_ENABLE | LCDC_OBJ_ENABLE | LCDC_TILE_DATA;
+    const uint8_t band = (uint8_t)(scene | LCDC_BG_TILEMAP);
+
+    int failures = 0;
+    run_switching_frame(ctx, scene, band);
+
+    for (uint32_t y = 0; y < 3u; ++y) {
+        if (ctx->ppu_scanline_lcdc[y] != scene) {
+            fprintf(
+                stderr,
+                "scanline LCDC: row %u recorded 0x%02X, expected the scene map 0x%02X\n",
+                y,
+                ctx->ppu_scanline_lcdc[y],
+                scene);
+            failures++;
+        }
+    }
+    /* The write lands between two rows, so row 3 is whichever side of the dot
+     * transfer it caught - the record keeps the value that row began with. */
+    if (ctx->ppu_scanline_lcdc[3] != scene && ctx->ppu_scanline_lcdc[3] != band) {
+        fprintf(
+            stderr,
+            "scanline LCDC: row 3 recorded 0x%02X, expected one of 0x%02X/0x%02X\n",
+            ctx->ppu_scanline_lcdc[3],
+            scene,
+            band);
+        failures++;
+    }
+    for (uint32_t y = 4u; y < GB_SCREEN_HEIGHT; ++y) {
+        if (ctx->ppu_scanline_lcdc[y] != band) {
+            fprintf(
+                stderr,
+                "scanline LCDC: row %u recorded 0x%02X, expected the band's map 0x%02X\n",
+                y,
+                ctx->ppu_scanline_lcdc[y],
+                band);
+            failures++;
+            break;
+        }
+    }
+
+    /* A frame that does not switch re-records every row: the record is the
+     * frame's, not the session's. */
+    run_quiet_frame(ctx, scene);
+    for (uint32_t y = 0; y < GB_SCREEN_HEIGHT; ++y) {
+        if (ctx->ppu_scanline_lcdc[y] != scene) {
+            fprintf(
+                stderr,
+                "scanline LCDC: quiet frame left row %u at 0x%02X, expected 0x%02X\n",
+                y,
+                ctx->ppu_scanline_lcdc[y],
+                scene);
+            failures++;
+            break;
+        }
+    }
+
+    gb_context_destroy(ctx);
+    if (failures != 0) {
+        fprintf(stderr, "scanline LCDC: %d failure(s)\n", failures);
+        return 1;
+    }
+    printf("scanline LCDC: rows 0-2 scene, 4-143 the band's map, both re-recorded\n");
+    return 0;
+}
