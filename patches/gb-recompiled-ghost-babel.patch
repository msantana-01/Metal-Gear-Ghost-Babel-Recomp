+static float clampf(float value, float low, float high) {
+    return value < low ? low : (value > high ? high : value);
+}
+
+static float smooth_ramp(float t) {
+    const float v = clampf(t, 0.0f, 1.0f);
+    return v * v * (3.0f - 2.0f * v);
+}
+
+/* Antialiased coverage of the band [lo,hi] at position t: a trapezoid that
+ * ramps over `soft` at each end and stops at `hi`. The stopping is the point -
+ * a ramp centred on the edge bleeds `soft` past it, and two bleeding edges
+ * widen a 0.22 pixel gap into nearly 0.4, which is the difference between an
+ * LCD panel and a dot matrix. */
+static float band_coverage(float t, float lo, float hi, float soft) {
+    if (hi <= lo || soft <= 0.0f) {
+        return 0.0f;
+    }
+    return smooth_ramp((t - lo) / soft) * smooth_ramp((hi - t) / soft);
+}
+
+/* Builds the multiply mask drawn over the presented guest image.
+ *
+ * White leaves the guest untouched, grey darkens it, so the mask is composited
+ * with SDL_BLENDMODE_MUL and a single percent controls the strength of every
+ * effect.
+ *
+ * The mask is rasterised at `lattice` mask pixels per guest pixel, where the
+ * caller passes the on-screen scale factor. That coupling is the whole design:
+ * a gap of a fifth of a guest pixel is barely one screen pixel at 480p and
+ * several at 4K, so a mask on a fixed guest multiple either snaps the gap to
+ * whole sub-columns (and the grid reads as a dot matrix) or blurs it. Rasterised
+ * at the destination, one mask pixel is one screen pixel and the gap comes out
+ * the width it was asked for at every window size. dst_w must be an exact
+ * multiple of GB_SCREEN_WIDTH.
+ *
+ * scale_factor is that same on-screen scale, kept separate because the gap also
+ * has to survive the low end: 0.22 guest pixels is 0.66 screen pixels at 480p
+ * (3x), which aliases into shimmering noise rather than reading as a line.
+ * Holding the gap to at least one screen pixel is what lets one setting hold up
+ * at both ends, and it is why the effect stays visible at 480p instead of
+ * fading out there.
+ */
+static void compute_screen_effect_overlay(uint32_t* dst, int dst_w, int dst_h,
+                                          int effect, int intensity_percent,
+                                          float scale_factor) {
+    const float amount = clampf((float)intensity_percent / 100.0f, 0.0f, 1.0f);
+    /* Below 2x there is no room for a gap that reads as a line instead of as
+     * shading, so the effect fades out rather than turning the screen muddy. */
+    const float usable = clampf(scale_factor - 1.0f, 0.0f, 1.0f);
+    const float strength = amount * usable;
+
+    const float one_screen_pixel = (scale_factor > 1.0f) ? (1.0f / scale_factor) : 1.0f;
+    const float gap = clampf(fmaxf(GB_SCREEN_EFFECT_GAP_GUEST,
+                                   GB_SCREEN_EFFECT_MIN_GAP_SCREEN * one_screen_pixel),
+                             0.0f, GB_SCREEN_EFFECT_MAX_GAP_GUEST);
+
+    const int lattice = (dst_w > 0) ? (dst_w / GB_SCREEN_WIDTH) : 1;
+    const int steps = (lattice > 0) ? lattice : 1;
+    /* Half a mask pixel: the standard analytic coverage ramp. Anything steeper
+     * stops resolving the gap and snaps it to whole samples. */
+    float soft = 0.5f / (float)steps;
+    /* The grid draws half a gap on each side, so its border has to stay wider
+     * than the ramp or the plateau between the two shoulders disappears. */
+    const float border = gap * 0.5f;
+    if (soft > border * 0.9f) {
+        soft = border * 0.9f;
+    }
+
+    float fx_lut[GB_SCREEN_EFFECT_MAX_LATTICE];
+    float fy_lut[GB_SCREEN_EFFECT_MAX_LATTICE];
+    if (steps > GB_SCREEN_EFFECT_MAX_LATTICE) {
+        return;
+    }
+    for (int i = 0; i < steps; ++i) {
+        fx_lut[i] = ((float)i + 0.5f) / (float)steps;
+        fy_lut[i] = fx_lut[i];
+    }
+
+    for (int y = 0; y < dst_h; ++y) {
+        const float fy = fy_lut[y % steps];
+        uint32_t* row = dst + (size_t)y * (size_t)dst_w;
+        for (int x = 0; x < dst_w; ++x) {
+            float darkness = 0.0f;
+            if (effect == GB_SCREEN_EFFECT_SCANLINES) {
+                /* Trailing edge only: the classic scanline, not a shaded cell. */
+                darkness = band_coverage(fy, 1.0f - gap, 1.0f, soft);
+            } else if (effect == GB_SCREEN_EFFECT_LCD_GRID) {
+                /* Half a gap on every side, so that two neighbouring borders meet
+                 * to form one gap of the requested width: a lit square framed by
+                 * darkness, which is what an LCD cell looks like. */
+                const float fx = fx_lut[x % steps];
+                const float vertical = fmaxf(band_coverage(fy, 0.0f, border, soft),
+                                             band_coverage(fy, 1.0f - border, 1.0f, soft));
+                const float horizontal = fmaxf(band_coverage(fx, 0.0f, border, soft),
+                                               band_coverage(fx, 1.0f - border, 1.0f, soft));
+                darkness = fmaxf(vertical, horizontal);
+            }
+            darkness *= strength;
+            const uint32_t level = (uint32_t)lrintf(255.0f * (1.0f - clampf(darkness, 0.0f, 1.0f)));
+            row[x] = 0xFF000000u | (level << 16) | (level << 8) | level;
+        }
+    }
+}
