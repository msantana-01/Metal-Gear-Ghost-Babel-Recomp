+    float fy_lut[GB_SCREEN_EFFECT_MAX_LATTICE];
+    if (steps > GB_SCREEN_EFFECT_MAX_LATTICE) {
+        return;
+    }
+    for (int i = 0; i < steps; ++i) {
+        fx_lut[i] = ((float)i + 0.5f) / (float)steps;
+        fy_lut[i] = fx_lut[i];
+    }
