diff --git a/runtime/src/shaders/crt.frag b/runtime/src/shaders/crt.frag
new file mode 100644
index 0000000..d647e14
--- /dev/null
+++ b/runtime/src/shaders/crt.frag
@@ -0,0 +1,74 @@
+#version 330 core
+
+in vec2 TexCoord;
+out vec4 FragColor;
+
+uniform sampler2D u_texture;
+uniform float u_intensity;
+uniform float u_time;
+uniform vec2 u_resolution;
+
+/* Scanline mask: trailing edge only, darkening the bottom of each guest row. */
+float scanline(float y, float amount, float soft) {
+    float gap = 0.22f;
+    float t = fract(y * 1.0f);
+    float edge = 1.0f - gap;
+    float ramp = smoothstep(edge, edge + soft, t);
+    return amount * ramp;
+}
+
+/* Subtle chromatic aberration: shift R and B by tiny amounts toward screen edges. */
+vec3 chromatic_aberration(sampler2D tex, vec2 uv, float amount, vec2 resolution) {
+    float strength = amount * 0.004f;
+    vec2 offset = (uv - 0.5f) * strength;
+    float r = texture(tex, uv + offset).r;
+    float g = texture(tex, uv).g;
+    float b = texture(tex, uv - offset).b;
+    return vec3(r, g, b);
+}
+
+/* Vignette: darken corners toward edges. */
+float vignette(vec2 uv, float amount) {
+    vec2 center = vec2(0.5f);
+    float dist = distance(uv, center);
+    return 1.0f - amount * dist * dist * 0.5f;
+}
+
+/* Phosphor glow: additive bloom above threshold. We simulate a cheap version
+ * by lifting blacks slightly toward a warm glow at bright pixels. */
+vec3 phosphor_glow(vec3 color, float amount) {
+    float luminance = dot(color, vec3(0.299f, 0.587f, 0.114f));
+    float glow = smoothstep(0.75f, 1.0f, luminance);
+    vec3 warm = vec3(1.0f, 0.9f, 0.7f);
+    return color + glow * warm * amount * 0.3f;
+}
+
+void main() {
+    vec2 uv = TexCoord;
+
+    /* Sample the guest frame. */
+    vec4 tex = texture(u_texture, uv);
+    vec3 color = tex.rgb;
+
+    /* Apply effects scaled by intensity (0..1). */
+    float amt = clamp(u_intensity, 0.0f, 1.0f);
+
+    /* Scanlines. */
+    float line = scanline(uv.y, amt, 0.08f);
+    color *= (1.0f - line);
+
+    /* Subtle chromatic aberration at low intensity. */
+    if (amt > 0.1f) {
+        color = chromatic_aberration(u_texture, uv, amt, u_resolution);
+    }
+
+    /* Vignette. */
+    color *= vignette(uv, amt * 0.15f);
+
+    /* Phosphor glow on bright pixels. */
+    if (amt > 0.2f) {
+        color = phosphor_glow(color, amt);
+    }
+
+    FragColor = vec4(color, tex.a);
+}
