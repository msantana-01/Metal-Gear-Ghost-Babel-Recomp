From 0f136029493acfd566b49f6db892bb9ddba9d712 Mon Sep 17 00:00:00 2001
From: Moises Santana <moises.santana@ifba.edu.br>
Date: Wed, 7 Oct 2026 12:56:58 -0300
Subject: [PATCH 02/36] fix: DMG-compat I/O readback gates and calibrated
 post-boot DIV

unused_hwio-GS/C and boot_div-cgb0 now pass; boot_div-cgbABCDE stays a
known gap (its fingerprint wants a constant two ticks lower than
boot_div-cgb0 verifies).

- SC write: present bit 1 in DMG and DMG-compat (gb_is_cgb_mode), not
  only on DMG hardware
- TAC reads back with unused bits set (|0xF8)
- FF68-FF6B: CGB-hardware gate; FF69/FF6B additionally CGB-mode only
- unused IO ranges read as open bus (0xFF) instead of io[] zero
- DMG-compat post-boot div_counter 0x2884 (0xABCC - 0x8300 - 72 T for
  nops 24 vs 6) matches boot_div-cgb0 exactly

Evidence: mooneye suite 74/75; ctest 84/85 (remaining failure is
pre-existing on baseline). Contract runtime_tree_sha256 refreshed to
match the runtime tree.
---
 .../standalone/gbrecomp-contract.json         |  2 +-
 runtime/src/gbrt.c                            | 36 +++++++++++++++++--
 2 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/ports/pokemon-crystal/standalone/gbrecomp-contract.json b/ports/pokemon-crystal/standalone/gbrecomp-contract.json
index 9807328..6eebab8 100644
--- a/ports/pokemon-crystal/standalone/gbrecomp-contract.json
+++ b/ports/pokemon-crystal/standalone/gbrecomp-contract.json
@@ -19,5 +19,5 @@
     "machine-readable-generation-progress",
     "source-built-port-extensions"
   ],
-  "runtime_tree_sha256": "0738bef096d9140c83df682490ad4b85a90aef7d9c1867ede695b520d2152cc8"
+  "runtime_tree_sha256": "fc683e854efb1117d638173f17c826870893ec73c8091460e208e238f6373493"
 }
diff --git a/runtime/src/gbrt.c b/runtime/src/gbrt.c
index cb01b84..236f173 100644
--- a/runtime/src/gbrt.c
+++ b/runtime/src/gbrt.c
@@ -1285,7 +1285,13 @@ void gb_context_reset(GBContext* ctx, bool skip_bootrom) {
             ctx->bc = compat_b;
             ctx->de = 0x0008;
             ctx->hl = (compat_b == 0x43 || compat_b == 0x58) ? 0x991A : 0x007C;
-            ctx->div_counter = 0x0000;
+            /* Post-boot DIV for DMG-compat on CGB. Calibrated so that
+             * mooneye misc/boot_div-cgb0 (nops 24 + shared read cadence) sees
+             * the verified 29 2A 2A 2B 2C 2E sequence: it is the passing DMG
+             * value 0xABCC shifted by 0x83*256 and minus the 72 T-cycle
+             * (nops 24 vs nops 6) later first read. boot_div-cgbABCDE wants
+             * a value two ticks lower and stays a known gap. */
+            ctx->div_counter = 0x2884;
         } else {
             ctx->af = 0x01B0;
             ctx->bc = 0x0013;
@@ -2696,6 +2702,7 @@ static uint8_t gbrt_read8_impl(GBContext* ctx,
             return res;
         }
         if (addr == 0xFF04) return (uint8_t)(ctx->div_counter >> 8);
+        if (addr == 0xFF07) return (uint8_t)(ctx->io[0x07] | 0xF8);
         if (addr == 0xFF0F) return (uint8_t)(0xE0 | (ctx->io[0x0F] & 0x1F));
         if (addr == 0xFF4D) {
             if (!gb_is_cgb_mode(ctx)) return 0xFF;
@@ -2753,6 +2760,11 @@ static uint8_t gbrt_read8_impl(GBContext* ctx,
             return ppu_read_register((GBPPU*)ctx->ppu, addr);
         }
         if (addr >= 0xFF68 && addr <= 0xFF6B) {
+            /* BGPI/OBPI/BGPD/OBPD: CGB hardware only; palette data reads are
+             * also CGB-mode only (SameBoy: a CGB in DMG mode can access BGPI
+             * and OBPI, but not BGPD and OBPD). */
+            if (!gb_is_cgb_hardware(ctx)) return 0xFF;
+            if ((addr == 0xFF69 || addr == 0xFF6B) && !gb_is_cgb_mode(ctx)) return 0xFF;
             gb_sync(ctx);
             return ppu_read_register((GBPPU*)ctx->ppu, addr);
         }
@@ -2760,6 +2772,25 @@ static uint8_t gbrt_read8_impl(GBContext* ctx,
             gbrt_audio_sync(ctx);
             return gb_audio_read(ctx, addr);
         }
+        switch (addr) {
+            case 0xFF03:
+            case 0xFF08: case 0xFF09: case 0xFF0A: case 0xFF0B:
+            case 0xFF0C: case 0xFF0D: case 0xFF0E:
+            case 0xFF4C: case 0xFF4E: case 0xFF50:
+            case 0xFF57: case 0xFF58: case 0xFF59: case 0xFF5A:
+            case 0xFF5B: case 0xFF5C: case 0xFF5D: case 0xFF5E:
+            case 0xFF5F: case 0xFF60: case 0xFF61: case 0xFF62:
+            case 0xFF63: case 0xFF64: case 0xFF65: case 0xFF66:
+            case 0xFF67:
+            case 0xFF6D: case 0xFF6E: case 0xFF6F:
+            case 0xFF71:
+            case 0xFF78: case 0xFF79: case 0xFF7A: case 0xFF7B:
+            case 0xFF7C: case 0xFF7D: case 0xFF7E: case 0xFF7F:
+                /* Unused IO reads as open bus (all 1s). */
+                return 0xFF;
+            default:
+                break;
+        }
         return ctx->io[addr - 0xFF00];
     }
     if (addr < 0xFFFF) return ctx->hram[addr - 0xFF80];
@@ -2998,7 +3029,8 @@ static void gbrt_write8_impl(GBContext* ctx,
         }
         if (addr == 0xFF02) {
             uint8_t sc = (uint8_t)(0x7C | (value & 0x83));
-            if (!gb_is_cgb_hardware(ctx)) {
+            if (!gb_is_cgb_mode(ctx)) {
+                /* DMG and DMG-compat always present bit 1 set. */
                 sc |= 0x02;
             }
             ctx->io[0x02] = sc;
-- 
