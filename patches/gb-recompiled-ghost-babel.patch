 #define GB_PRESENTATION_MAX_MAP_BLOCKS 4096u
@@ -189,6 +189,15 @@ typedef struct GBPresentationHardwareSnapshot {
     uint8_t background_palettes[0x40];
     uint8_t object_palettes[0x40];
     uint16_t accurate_pixels[GB_PRESENTATION_ACCURATE_PIXEL_COUNT];
+    /* LCDC as each visible scanline began drawing it, in LY order. `lcdc` is
+     * the register as the frame ended, which is what the rows still on the
+     * first background map used; a row whose background-map bit differs from
+     * this snapshot's was assembled from the other map. Ghost Babel's bottom
+     * HUD band is the case that made this necessary: the game selects the
+     * second map for the band and restores the register at vblank, so the
